     return ptr;
 }
 
+/***********************************************************************
+ *           next_user_handle_ptr
+ *
+ * Return the next object of the requested type in the process user
+ * handle table, starting the search after *handle (0 to start from
+ * the beginning) and storing the found object's handle back into
+ * *handle. The caller must hold the user lock; the returned pointer
+ * stays valid until the lock is released. Returns NULL when no
+ * further object of the type exists.
+ */
+void *next_user_handle_ptr( HANDLE *handle, unsigned int type )
+{
+    UINT index = *handle ? USER_HANDLE_TO_INDEX( *handle ) + 1 : 0;
+    struct user_object *ptr;
+
+    for (; index < NB_USER_HANDLES; index++)
+    {
+        if (!(ptr = user_handles[index])) continue;
+        if (ptr->type != type) continue;
+        *handle = ptr->handle;
+        return ptr;
+    }
+    return NULL;
+}
