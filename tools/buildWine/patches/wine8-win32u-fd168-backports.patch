+/***********************************************************************
+ *           NtUserBuildNameList   (win32u.@)
+ *
+ * This vintage's server enumerates window stations and desktops one
+ * name per request (enum_winstation / enum_desktop by index), so the
+ * list is built by looping those requests; the buffer layout, count
+ * and size accounting follow the upstream implementation.
+ */
+NTSTATUS WINAPI NtUserBuildNameList( HWINSTA handle, ULONG size, struct ntuser_name_list *list,
+                                     ULONG *ret_size )
+{
+    const ULONG header_size = offsetof( struct ntuser_name_list, strings[1] ); /* header + final null */
+    ULONG capacity, written = 0, count = 0, total = 0;
+    unsigned int index = 0;
+    NTSTATUS status;
+
+    if (size <= header_size) return STATUS_INVALID_HANDLE;
+    capacity = size - header_size;
+
+    for (;;)
+    {
+        WCHAR name[MAX_PATH];
+        ULONG name_bytes = 0;
+
+        if (handle)
+        {
+            SERVER_START_REQ( enum_desktop )
+            {
+                req->winstation = wine_server_obj_handle( handle );
+                req->index = index;
+                wine_server_set_reply( req, name, sizeof(name) - sizeof(WCHAR) );
+                status = wine_server_call( req );
+                if (!status)
+                {
+                    name_bytes = wine_server_reply_size( reply );
+                    index = reply->next;
+                }
+            }
+            SERVER_END_REQ;
+        }
+        else
+        {
+            SERVER_START_REQ( enum_winstation )
+            {
+                req->index = index;
+                wine_server_set_reply( req, name, sizeof(name) - sizeof(WCHAR) );
+                status = wine_server_call( req );
+                if (!status)
+                {
+                    name_bytes = wine_server_reply_size( reply );
+                    index = reply->next;
+                }
+            }
+            SERVER_END_REQ;
+        }
+        if (status == STATUS_NO_MORE_ENTRIES) break;
+        if (status) return status;
+
+        count++;
+        total += name_bytes + sizeof(WCHAR);
+        if (total <= capacity)
+        {
+            memcpy( (char *)list->strings + written, name, name_bytes );
+            written += name_bytes;
+            *(WCHAR *)((char *)list->strings + written) = 0;
+            written += sizeof(WCHAR);
+        }
+    }
+
+    list->size = header_size + written;
+    list->count = count;
+    list->strings[written / sizeof(WCHAR)] = 0;
+    *ret_size = header_size + total;
+    return total <= capacity ? STATUS_SUCCESS : STATUS_BUFFER_TOO_SMALL;
+}
