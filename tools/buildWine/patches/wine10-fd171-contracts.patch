+/* Walk the Enum registry tree collecting device instance IDs that
+ * match the CM_Get_Device_ID_List filter. In this device model every
+ * device recorded under Enum is present, and no relation data
+ * (eject/removal/power/bus/transport relations between devices) is
+ * recorded anywhere, so relation filters match no device. */
+static void cm171_collect_device_ids( const WCHAR *filter, ULONG flags, struct cm171_collect *collect )
+{
+    WCHAR enum_name[MAX_PATH], dev_name[MAX_PATH], inst_name[MAX_PATH];
+    BOOL want_enum = !!(flags & CM171_GETIDLIST_FILTER_ENUMERATOR);
+    BOOL want_service = !!(flags & CM171_GETIDLIST_FILTER_SERVICE);
+    BOOL want_class = !!(flags & CM171_GETIDLIST_FILTER_CLASS);
+    BOOL relations = !!(flags & CM171_GETIDLIST_FILTER_RELATIONS);
+    HKEY enum_root, enum_key, dev_key, inst_key;
+    DWORD i, j, k;
+
+    if (relations) return;
+    if ((want_enum || want_service || want_class) && !filter) want_enum = want_service = want_class = FALSE;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, Enum, 0, KEY_READ, &enum_root )) return;
+
+    for (i = 0; ; i++)
+    {
+        DWORD len = ARRAY_SIZE(enum_name);
+        if (RegEnumKeyExW( enum_root, i, enum_name, &len, NULL, NULL, NULL, NULL )) break;
+        if (want_enum && wcsicmp( enum_name, filter )) continue;
+        if (RegOpenKeyExW( enum_root, enum_name, 0, KEY_READ, &enum_key )) continue;
+
+        for (j = 0; ; j++)
+        {
+            len = ARRAY_SIZE(dev_name);
+            if (RegEnumKeyExW( enum_key, j, dev_name, &len, NULL, NULL, NULL, NULL )) break;
+            if (RegOpenKeyExW( enum_key, dev_name, 0, KEY_READ, &dev_key )) continue;
+
+            for (k = 0; ; k++)
+            {
+                WCHAR id[MAX_DEVICE_ID_LEN];
+                len = ARRAY_SIZE(inst_name);
+                if (RegEnumKeyExW( dev_key, k, inst_name, &len, NULL, NULL, NULL, NULL )) break;
+
+                if (want_service || want_class)
+                {
+                    WCHAR value[256];
+                    DWORD size;
+                    BOOL match = TRUE;
+
+                    if (RegOpenKeyExW( dev_key, inst_name, 0, KEY_READ, &inst_key )) continue;
+                    if (want_service)
+                    {
+                        size = sizeof(value);
+                        if (RegQueryValueExW( inst_key, Service, NULL, NULL, (BYTE *)value, &size )
+                                || wcsicmp( value, filter ))
+                            match = FALSE;
+                    }
+                    if (match && want_class)
+                    {
+                        static const WCHAR ClassGUID[] = {'C','l','a','s','s','G','U','I','D',0};
+                        size = sizeof(value);
+                        if (RegQueryValueExW( inst_key, ClassGUID, NULL, NULL, (BYTE *)value, &size )
+                                || wcsicmp( value, filter ))
+                            match = FALSE;
+                    }
+                    RegCloseKey( inst_key );
+                    if (!match) continue;
+                }
+
+                lstrcpyW( id, enum_name );
+                lstrcatW( id, cm171_slashW );
+                lstrcatW( id, dev_name );
+                lstrcatW( id, cm171_slashW );
+                lstrcatW( id, inst_name );
+                if (!cm171_collect_append( collect, id )) goto done;
+            }
+            RegCloseKey( dev_key );
+        }
+        RegCloseKey( enum_key );
+    }
+done:
+    RegCloseKey( enum_root );
+}
+
+/***********************************************************************
+ *           CM_Get_Device_ID_List_Size_ExW   (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Device_ID_List_Size_ExW( ULONG *len, const WCHAR *filter, ULONG flags, HMACHINE machine )
+{
+    struct cm171_collect collect = {0};
+
+    TRACE( "len %p, filter %s, flags %#lx, machine %p\n", len, debugstr_w(filter), flags, machine );
+    if (machine) FIXME( "machine %p not implemented!\n", machine );
+
+    if (!len) return CR_INVALID_POINTER;
+    if (flags & ~CM171_GETIDLIST_FILTER_BITS) return CR_INVALID_FLAG;
+
+    cm171_collect_device_ids( filter, flags, &collect );
+    *len = cm171_collect_total( &collect );
