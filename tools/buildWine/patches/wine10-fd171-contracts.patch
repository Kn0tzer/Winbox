+/***********************************************************************
+ *           CM functions backported for FD-171
+ *
+ * The cfgmgr32 configuration-manager functions below used to be spec
+ * stubs in both cfgmgr32 and setupapi. Upstream Wine eventually
+ * implemented them in cfgmgr32 on top of a device/property model that
+ * does not exist in this vintage; here they are implemented directly
+ * on this tree's device model, where the SETUPDI code keeps the same
+ * truth in the registry: devices under System\CurrentControlSet\Enum,
+ * classes under ...\Control\Class, device interfaces under
+ * ...\Control\DeviceClasses. The observable contracts (argument
+ * validation order, CONFIGRET codes, size accounting) follow the
+ * upstream implementations in dlls/cfgmgr32/cfgmgr32.c.
+ */
+
+static const WCHAR cm171_slashW[] = {'\\',0};
+
+#define CM171_ENUMERATE_CLASSES_INSTALLER   0x00000000
+#define CM171_ENUMERATE_CLASSES_BITS        0x00000001
+#define CM171_OPEN_CLASS_KEY_INSTALLER      0x00000000
+#define CM171_OPEN_CLASS_KEY_BITS           0x00000001
+#define CM171_GET_DEVICE_INTERFACE_LIST_ALL_DEVICES 0x00000001
+#define CM171_GET_DEVICE_INTERFACE_LIST_BITS        0x00000001
+#define CM171_GETIDLIST_FILTER_BITS         0x100003FF
+#define CM171_GETIDLIST_FILTER_ENUMERATOR   0x00000001
+#define CM171_GETIDLIST_FILTER_SERVICE      0x00000002
+#define CM171_GETIDLIST_FILTER_RELATIONS    0x000000AC
+#define CM171_GETIDLIST_FILTER_PRESENT      0x00000100
+#define CM171_GETIDLIST_FILTER_CLASS        0x00000200
+#define CM171_GETIDLIST_DONOTGENERATE       0x10000040
+
+static CONFIGRET cm171_map_error( LSTATUS err )
+{
+    switch (err)
+    {
+    case ERROR_INVALID_PARAMETER:   return CR_FAILURE;
+    case ERROR_INVALID_USER_BUFFER: return CR_INVALID_POINTER;
+    case ERROR_FILE_NOT_FOUND:      return CR_NO_SUCH_REGISTRY_KEY;
+    case ERROR_MORE_DATA:           return CR_BUFFER_SMALL;
+    case ERROR_NO_MORE_ITEMS:       return CR_NO_SUCH_VALUE;
+    case ERROR_NOT_FOUND:           return CR_NO_SUCH_VALUE;
+    case ERROR_SUCCESS:             return CR_SUCCESS;
+    default: WARN( "unmapped error %lu\n", err ); return CR_FAILURE;
+    }
+}
+
+static LSTATUS cm171_open_key( HKEY root, const WCHAR *key, REGSAM access, BOOL open, HKEY *hkey )
+{
+    LSTATUS err;
+
+    if (open) return RegOpenKeyExW( root, key, 0, access, hkey );
+
+    err = RegCreateKeyExW( root, key, 0, NULL, 0, access, NULL, hkey, NULL );
+    if (err == ERROR_CHILD_MUST_BE_VOLATILE)
+        err = RegCreateKeyExW( root, key, 0, NULL, REG_OPTION_VOLATILE, access, NULL, hkey, NULL );
+    return err;
+}
+
+static LSTATUS cm171_open_subkey( HKEY root, const WCHAR *prefix, const WCHAR *suffix,
+                                  REGSAM access, BOOL open, HKEY *hkey )
+{
+    WCHAR path[MAX_PATH];
+    ULONG len = lstrlenW( prefix ) + 1 + lstrlenW( suffix );
+
+    if (len >= ARRAY_SIZE(path)) return ERROR_FILENAME_EXCED_RANGE;
+    lstrcpyW( path, prefix );
+    lstrcatW( path, cm171_slashW );
+    lstrcatW( path, suffix );
+    return cm171_open_key( root, path, access, open, hkey );
+}
+
+static BOOL cm171_guid_from_string( const WCHAR *str, GUID *guid )
+{
+    /* strict "{xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}" parse */
+    static const int byte_pos[8] = {0, 2, 4, 6, 9, 11, 14, 16};
+    DWORD v[11];
+    int i, j;
+
+    if (lstrlenW( str ) != 38 || str[0] != '{' || str[37] != '}' ||
+        str[9] != '-' || str[14] != '-' || str[19] != '-' || str[24] != '-')
+        return FALSE;
+    for (i = 0; i < 11; i++)
+    {
+        int digits = (i == 0) ? 8 : (i < 3 ? 4 : 2);
+        /* positions: { at 0, fields start at 1, 10, 15, then the eight
+         * Data4 bytes at 20,22,25,27,30,32,35,37 - wait, 38-char form:
+         * indexes 20,22 are before the 24 '-'... computed explicitly: */
+        static const int pos_tab[11] = {1, 10, 15, 20, 22, 25, 27, 29, 31, 33, 35};
+        int pos = pos_tab[i];
+        DWORD val = 0;
+        for (j = 0; j < digits; j++)
+        {
+            WCHAR c = str[pos + j];
+            val <<= 4;
+            if (c >= '0' && c <= '9') val |= c - '0';
+            else if (c >= 'a' && c <= 'f') val |= c - 'a' + 10;
+            else if (c >= 'A' && c <= 'F') val |= c - 'A' + 10;
+            else return FALSE;
+        }
+        v[i] = val;
+    }
+    (void)byte_pos;
+    guid->Data1 = v[0];
+    guid->Data2 = (unsigned short)v[1];
+    guid->Data3 = (unsigned short)v[2];
+    for (i = 0; i < 8; i++) guid->Data4[i] = (unsigned char)v[3 + i];
+    return TRUE;
+}
+
+/* growable multi-string collector (wide) */
+struct cm171_collect
+{
+    WCHAR *data;
+    ULONG chars; /* chars stored, excluding the final list terminator */
+    ULONG cap;
+};
+
+static BOOL cm171_collect_append( struct cm171_collect *c, const WCHAR *str )
+{
+    ULONG len = lstrlenW( str ) + 1;
+
+    if (c->chars + len + 1 > c->cap)
+    {
+        ULONG ncap = max( c->cap * 2, c->chars + len + 1 );
+        WCHAR *ndata = heap_realloc( c->data, ncap * sizeof(WCHAR) );
+        if (!ndata) return FALSE;
+        c->data = ndata;
+        c->cap = ncap;
+    }
+    memcpy( c->data + c->chars, str, len * sizeof(WCHAR) );
+    c->chars += len;
+    return TRUE;
+}
+
+static ULONG cm171_collect_total_a( const struct cm171_collect *c );
+
+static ULONG cm171_collect_total( const struct cm171_collect *c )
+{
+    return c->chars + 1; /* final list terminator */
+}
+
+/* deliver a collected wide multi-string into the caller's buffer */
+static CONFIGRET cm171_deliver_w( const struct cm171_collect *c, WCHAR *buffer, ULONG len )
+{
+    memset( buffer, 0, len * sizeof(WCHAR) );
+    if (cm171_collect_total( c ) > len) return CR_BUFFER_SMALL;
+    if (c->chars) memcpy( buffer, c->data, c->chars * sizeof(WCHAR) );
+    return CR_SUCCESS;
+}
+
+/* deliver a collected wide multi-string converted to ANSI */
+static CONFIGRET cm171_deliver_a( const struct cm171_collect *c, char *buffer, ULONG len )
+{
+    ULONG total = cm171_collect_total_a( c );
+    ULONG off = 0, aoff = 0;
+
+    memset( buffer, 0, len );
+    if (total > len) return CR_BUFFER_SMALL;
+    while (off < c->chars)
+    {
+        aoff += WideCharToMultiByte( CP_ACP, 0, c->data + off, -1, buffer + aoff, len - aoff, NULL, NULL );
+        off += lstrlenW( c->data + off ) + 1;
+    }
+    return CR_SUCCESS;
+}
+
+static ULONG cm171_collect_total_a( const struct cm171_collect *c )
+{
+    ULONG total = 1, off = 0;
+    while (off < c->chars)
+    {
+        total += WideCharToMultiByte( CP_ACP, 0, c->data + off, -1, NULL, 0, NULL, NULL );
+        off += lstrlenW( c->data + off ) + 1;
+    }
+    return total;
+}
+
+/***********************************************************************
+ *           CM_Enumerate_Classes_Ex   (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Enumerate_Classes_Ex( ULONG index, GUID *class, ULONG flags, HMACHINE machine )
+{
+    WCHAR buffer[39];
+    LSTATUS err;
+    HKEY root;
+
+    TRACE( "index %lu, class %s, flags %#lx, machine %p\n", index, debugstr_guid(class), flags, machine );
+    if (machine) FIXME( "machine %p not implemented!\n", machine );
+
+    if (!class) return CR_INVALID_POINTER;
+    if (flags & ~CM171_ENUMERATE_CLASSES_BITS) return CR_INVALID_FLAG;
+
+    if ((err = RegOpenKeyExW( HKEY_LOCAL_MACHINE,
+            flags == CM171_ENUMERATE_CLASSES_INSTALLER ? ControlClass : DeviceClasses,
+            0, KEY_READ, &root )))
+        return cm171_map_error( err );
+
+    err = RegEnumKeyW( root, index, buffer, ARRAY_SIZE(buffer) );
+    RegCloseKey( root );
+    if (err) return cm171_map_error( err );
+    if (!cm171_guid_from_string( buffer, class )) return CR_FAILURE;
+    return CR_SUCCESS;
+}
