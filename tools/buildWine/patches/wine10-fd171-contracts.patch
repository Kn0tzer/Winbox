+/* FD-171 backport (upstream Wine).  */
+struct auth_identity_marshalled
+{
+    ULONG version;
+    ULONG length;
+    ULONG user_off;
+    ULONG user_len;
+    ULONG domain_off;
+    ULONG domain_len;
+    ULONG password_off;
+    ULONG password_len;
+    ULONG flags;
+    ULONG package_list_off;
+    ULONG package_list_len;
+};
