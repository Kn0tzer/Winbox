+/* Collect the device interface paths of one interface class from the
+ * DeviceClasses registry tree, in the layout SETUPDI itself writes:
+ * DeviceClasses\{class}\<instance segment>\<"#"refstr> subkeys holding
+ * a "SymbolicLink" value; the caller-visible path is the symbolic
+ * link plus the reference string, when any. */
+static void cm171_collect_interfaces( const GUID *class, const WCHAR *instance_id, BOOL all,
+                                      struct cm171_collect *collect )
+{
+    WCHAR class_str[39], dev_name[MAX_PATH], ref_name[MAX_PATH];
+    WCHAR want_seg[MAX_DEVICE_ID_LEN];
+    HKEY classes_root, class_key, dev_key, ref_key;
+    DWORD i, j;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, DeviceClasses, 0, KEY_READ, &classes_root )) return;
+    SETUPDI_GuidToString( class, class_str );
+    if (RegOpenKeyExW( classes_root, class_str, 0, KEY_READ, &class_key ))
+    {
+        RegCloseKey( classes_root );
+        return;
+    }
+    RegCloseKey( classes_root );
+
+    if (instance_id)
+    {
+        WCHAR *p;
+        lstrcpynW( want_seg, instance_id, ARRAY_SIZE(want_seg) );
+        for (p = want_seg; *p; p++) if (*p == '\\') *p = '#';
+    }
+
+    for (i = 0; ; i++)
+    {
+        DWORD len = ARRAY_SIZE(dev_name);
+        if (RegEnumKeyExW( class_key, i, dev_name, &len, NULL, NULL, NULL, NULL )) break;
+
+        if (instance_id)
+        {
+            /* stored segment: the "##?#" munged prefix, then the
+             * instance path with '#' separators, then "#{class}" */
+            const WCHAR *seg = dev_name;
+            ULONG seglen = lstrlenW( want_seg );
+            if (lstrlenW( seg ) < 4 || seg[0] != '#' || seg[1] != '#' || seg[2] != '?' || seg[3] != '#') continue;
+            seg += 4;
+            if (wcsnicmp( seg, want_seg, seglen ) || (seg[seglen] && seg[seglen] != '#')) continue;
+        }
+
+        if (RegOpenKeyExW( class_key, dev_name, 0, KEY_READ, &dev_key )) continue;
+        for (j = 0; ; j++)
+        {
+            WCHAR link[MAX_PATH], entry[MAX_PATH + 64];
+            DWORD len = ARRAY_SIZE(ref_name), size;
+            if (RegEnumKeyExW( dev_key, j, ref_name, &len, NULL, NULL, NULL, NULL )) break;
+            if (ref_name[0] != '#') continue;
+            if (RegOpenKeyExW( dev_key, ref_name, 0, KEY_READ, &ref_key )) continue;
+            if (!all && !is_linked( ref_key ))
+            {
+                RegCloseKey( ref_key );
+                continue;
+            }
+            size = sizeof(link);
+            if (!RegQueryValueExW( ref_key, SymbolicLink, NULL, NULL, (BYTE *)link, &size ))
+            {
+                lstrcpyW( entry, link );
+                if (ref_name[1])
+                {
+                    lstrcatW( entry, cm171_slashW );
+                    lstrcatW( entry, ref_name + 1 );
+                }
+                if (!cm171_collect_append( collect, entry ))
+                {
+                    RegCloseKey( ref_key );
+                    RegCloseKey( dev_key );
+                    RegCloseKey( class_key );
+                    return;
+                }
+            }
+            RegCloseKey( ref_key );
+        }
+        RegCloseKey( dev_key );
+    }
+    RegCloseKey( class_key );
+}
