+/***********************************************************************
+ *           CM_Open_DevNode_Key_Ex   (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Open_DevNode_Key_Ex( DEVINST node, REGSAM access, ULONG profile,
+                                         REGDISPOSITION disposition, HKEY *hkey, ULONG flags, HMACHINE machine )
+{
+    BOOL open = disposition == RegDisposition_OpenExisting;
+    HKEY root = HKEY_LOCAL_MACHINE;
+    struct device *device;
+    LSTATUS err;
+
+    TRACE( "node %#lx, access %#lx, profile %lu, disposition %#lx, hkey %p, flags %#lx, machine %p\n",
+           node, access, profile, disposition, hkey, flags, machine );
+    if (machine) FIXME( "machine %p not implemented!\n", machine );
+
+    if (!(device = get_devnode_device( node ))) return CR_NO_SUCH_DEVNODE;
+    if ((flags & (CM_REGISTRY_USER | CM_REGISTRY_CONFIG)) == (CM_REGISTRY_USER | CM_REGISTRY_CONFIG))
+        return CR_INVALID_FLAG;
+
+    if (flags & CM_REGISTRY_CONFIG) root = HKEY_CURRENT_CONFIG;
+    else if (flags & CM_REGISTRY_USER) root = HKEY_CURRENT_USER;
+
+    if (flags & CM_REGISTRY_SOFTWARE)
+    {
+        WCHAR driver[MAX_PATH];
+        DWORD len = sizeof(driver);
+
+        if (RegQueryValueExW( device->key, Driver, NULL, NULL, (BYTE *)driver, &len ))
+            return cm171_map_error( ERROR_NOT_FOUND );
+        return cm171_map_error( cm171_open_subkey( root, ControlClass, driver, access, open, hkey ) );
+    }
+
+    if (root != HKEY_LOCAL_MACHINE)
+        return cm171_map_error( cm171_open_subkey( root, Enum, device->instanceId, access, open, hkey ) );
+
+    err = cm171_open_key( device->key, DeviceParameters, access, open, hkey );
+    return cm171_map_error( err );
+}
