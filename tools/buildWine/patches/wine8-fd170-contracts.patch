+#include "bluetoothapis.h"
+#include "bluetoothleapis.h"
+#include "setupapi.h"
+
+#include "initguid.h"
+#include "bthdef.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(bluetoothapis);
+
+struct bluetooth_find_radio_handle
+{
+    HDEVINFO devinfo;
+    DWORD idx;
+};
+
+/*********************************************************************
+ *  BluetoothFindFirstDevice
+ */
+HBLUETOOTH_DEVICE_FIND WINAPI BluetoothFindFirstDevice(BLUETOOTH_DEVICE_SEARCH_PARAMS *params,
+                                                       BLUETOOTH_DEVICE_INFO *info)
+{
+    FIXME("(%p %p): stub!\n", params, info);
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return NULL;
+}
+
+/*********************************************************************
+ *  BluetoothFindFirstRadio
+ */
+HBLUETOOTH_RADIO_FIND WINAPI BluetoothFindFirstRadio( BLUETOOTH_FIND_RADIO_PARAMS *params, HANDLE *radio )
+{
+    struct bluetooth_find_radio_handle *find;
+    HANDLE device_ret;
+    DWORD err;
+
+    TRACE( "(%p, %p)\n", params, radio );
+
+    if (!params)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (params->dwSize != sizeof( *params ))
+    {
+        SetLastError( ERROR_REVISION_MISMATCH );
+        return NULL;
+    }
+    if (!(find = calloc( 1, sizeof( *find ) )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return NULL;
+    }
+
+    find->devinfo = SetupDiGetClassDevsW( &GUID_BTHPORT_DEVICE_INTERFACE, NULL, NULL,
+                                          DIGCF_PRESENT | DIGCF_DEVICEINTERFACE );
+    if (find->devinfo == INVALID_HANDLE_VALUE)
+    {
+        free( find );
+        return NULL;
+    }
+
+    if (BluetoothFindNextRadio( find, &device_ret ))
+    {
+        *radio = device_ret;
+        return find;
+    }
+
+    err = GetLastError();
+    BluetoothFindRadioClose( find );
+    SetLastError( err );
+    return NULL;
+}
+
+/*********************************************************************
+ *  BluetoothFindRadioClose
+ */
+BOOL WINAPI BluetoothFindRadioClose( HBLUETOOTH_RADIO_FIND find_handle )
+{
+    struct bluetooth_find_radio_handle *find = find_handle;
+
+    TRACE( "(%p)\n", find_handle );
+
+    if (!find_handle)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+
+    SetupDiDestroyDeviceInfoList( find->devinfo );
+    free( find );
+    SetLastError( ERROR_SUCCESS );
+    return TRUE;
+}
+
+/*********************************************************************
+ *  BluetoothFindDeviceClose
+ */
+BOOL WINAPI BluetoothFindDeviceClose(HBLUETOOTH_DEVICE_FIND find)
+{
+    FIXME("(%p): stub!\n", find);
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
+
+/*********************************************************************
+ *  BluetoothFindNextRadio
+ */
+BOOL WINAPI BluetoothFindNextRadio( HBLUETOOTH_RADIO_FIND find_handle, HANDLE *radio )
+{
+    char buffer[sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W) + MAX_PATH * sizeof( WCHAR )];
+    struct bluetooth_find_radio_handle *find = find_handle;
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *iface_detail = (SP_DEVICE_INTERFACE_DETAIL_DATA_W *)buffer;
+    SP_DEVICE_INTERFACE_DATA iface_data;
+    HANDLE device_ret;
+    BOOL found;
+
+    TRACE( "(%p, %p)\n", find_handle, radio );
+
+    if (!find_handle)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+
+    iface_detail->cbSize = sizeof( *iface_detail );
+    iface_data.cbSize = sizeof( iface_data );
+    found = FALSE;
+    while (SetupDiEnumDeviceInterfaces( find->devinfo, NULL, &GUID_BTHPORT_DEVICE_INTERFACE, find->idx++,
+                                        &iface_data ))
+    {
+        if (!SetupDiGetDeviceInterfaceDetailW( find->devinfo, &iface_data, iface_detail, sizeof( buffer ), NULL,
+                                               NULL ))
+            continue;
+        device_ret = CreateFileW( iface_detail->DevicePath, GENERIC_READ | GENERIC_WRITE,
+                                  FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+        if (device_ret != INVALID_HANDLE_VALUE)
+        {
+            found = TRUE;
+            break;
+        }
+    }
+
+    if (found)
+        *radio = device_ret;
+
+    return found;
+}
+
+/*********************************************************************
+ *  BluetoothGetRadioInfo
+ */
+DWORD WINAPI BluetoothGetRadioInfo(HANDLE radio, PBLUETOOTH_RADIO_INFO info)
+{
+    FIXME("(%p, %p): stub!\n", radio, info);
+    return ERROR_CALL_NOT_IMPLEMENTED;
+}
+
+/*********************************************************************
+ *  BluetoothFindNextDevice
+ */
+BOOL WINAPI BluetoothFindNextDevice(HBLUETOOTH_DEVICE_FIND find, BLUETOOTH_DEVICE_INFO *info)
+{
+    FIXME("(%p, %p): stub!\n", find, info);
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
+
+/*********************************************************************
+ *  BluetoothRegisterForAuthenticationEx
+ */
+DWORD WINAPI BluetoothRegisterForAuthenticationEx(const BLUETOOTH_DEVICE_INFO *info, HBLUETOOTH_AUTHENTICATION_REGISTRATION *out,
+                                                  PFN_AUTHENTICATION_CALLBACK_EX callback, void *param)
+{
+    FIXME("(%p, %p, %p, %p): stub!\n", info, out, callback, param);
+    return ERROR_CALL_NOT_IMPLEMENTED;
+}
+
+/*********************************************************************
+ *  BluetoothUnregisterAuthentication
+ */
+BOOL WINAPI BluetoothUnregisterAuthentication(HBLUETOOTH_AUTHENTICATION_REGISTRATION handle)
+{
+    FIXME("(%p): stub!\n", handle);
+    if (!handle) SetLastError(ERROR_INVALID_HANDLE);
+    return FALSE;
+}
+
+/*********************************************************************
+ *  Bluetooth radio helpers
+ *
+ * This runtime has no Bluetooth radio stack: radio enumeration (via
+ * BluetoothFindFirstRadio/BluetoothFindNextRadio, which walk the
+ * setupapi device interfaces) is always empty here, so no handle a
+ * caller can hold names a radio, and no LE device handle can exist.
+ * The functions below still run the documented validation, in the same
+ * order as the native implementation, so callers get the answers a
+ * radio-less machine gives.
+ */
+
+static BOOL radio_handle_is_valid( HANDLE radio )
+{
+    BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof( params ) };
+    HBLUETOOTH_RADIO_FIND find;
+    HANDLE found = NULL;
+
+    find = BluetoothFindFirstRadio( &params, &found );
+    if (!find)
+        return FALSE;
+    for (;;)
+    {
+        HANDLE current = found;
+
+        if (current == radio)
+        {
+            CloseHandle( current );
+            BluetoothFindRadioClose( find );
+            return TRUE;
+        }
+        CloseHandle( current );
+        if (!BluetoothFindNextRadio( find, &found ))
+            break;
+    }
+    BluetoothFindRadioClose( find );
+    return FALSE;
+}
+
+/*********************************************************************
+ *  BluetoothEnableDiscovery
+ */
+BOOL WINAPI BluetoothEnableDiscovery( HANDLE radio, BOOL enable )
+{
+    TRACE( "(%p, %d)\n", radio, enable );
+
+    if (!radio)
+    {
+        /* A NULL radio means "every radio"; enumeration finds none. */
+        BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof( params ) };
+        HBLUETOOTH_RADIO_FIND find = BluetoothFindFirstRadio( &params, &radio );
+
+        if (!find)
+            return FALSE;
+        BluetoothFindRadioClose( find );
+        return FALSE;
+    }
+    if (!radio_handle_is_valid( radio ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    FIXME( "radio stack not available\n" );
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/*********************************************************************
+ *  BluetoothEnableIncomingConnections
+ */
+BOOL WINAPI BluetoothEnableIncomingConnections( HANDLE radio, BOOL enable )
+{
+    TRACE( "(%p, %d)\n", radio, enable );
+
+    if (!radio)
+    {
+        BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof( params ) };
+        HBLUETOOTH_RADIO_FIND find = BluetoothFindFirstRadio( &params, &radio );
+
+        if (!find)
+            return FALSE;
+        BluetoothFindRadioClose( find );
+        return FALSE;
+    }
+    if (!radio_handle_is_valid( radio ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    FIXME( "radio stack not available\n" );
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/*********************************************************************
+ *  BluetoothIsConnectable
+ */
+BOOL WINAPI BluetoothIsConnectable( HANDLE radio )
+{
+    TRACE( "(%p)\n", radio );
+
+    if (!radio)
+    {
+        BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof( params ) };
+        HBLUETOOTH_RADIO_FIND find = BluetoothFindFirstRadio( &params, &radio );
+
+        if (!find)
+            return FALSE;
+        BluetoothFindRadioClose( find );
+        /* No connectable radio can exist without a radio stack. */
+        return FALSE;
+    }
+    if (!radio_handle_is_valid( radio ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    return FALSE;
+}
+
+/*********************************************************************
+ *  Bluetooth GATT client functions
+ *
+ * Argument validation mirrors the native implementation's order.  The
+ * device step itself cannot succeed here: no Bluetooth LE device stack
+ * exists in this runtime, so no handle can name an LE device, and the
+ * native driver call fails for such a handle with ERROR_INVALID_HANDLE.
+ */
+
+HRESULT WINAPI BluetoothGATTGetServices( HANDLE device, USHORT count, BTH_LE_GATT_SERVICE *services,
+                                         USHORT *actual, ULONG flags )
+{
+    TRACE( "(%p, %u, %p, %p, %#lx)\n", device, count, services, actual, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!actual)
+        return E_POINTER;
+    if (!!services != !!count)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTGetCharacteristics( HANDLE device, BTH_LE_GATT_SERVICE *service, USHORT count,
+                                                BTH_LE_GATT_CHARACTERISTIC *characteristics, USHORT *actual,
+                                                ULONG flags )
+{
+    TRACE( "(%p, %p, %u, %p, %p, %#lx)\n", device, service, count, characteristics, actual, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!actual)
+        return E_POINTER;
+    if (characteristics && !count)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTGetDescriptors( HANDLE device, BTH_LE_GATT_CHARACTERISTIC *characteristic,
+                                            USHORT count, BTH_LE_GATT_DESCRIPTOR *descriptors, USHORT *actual,
+                                            ULONG flags )
+{
+    TRACE( "(%p, %p, %u, %p, %p, %#lx)\n", device, characteristic, count, descriptors, actual, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!actual)
+        return E_POINTER;
+    if (descriptors && !count)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTGetCharacteristicValue( HANDLE device, BTH_LE_GATT_CHARACTERISTIC *characteristic,
+                                                    ULONG size, BTH_LE_GATT_CHARACTERISTIC_VALUE *value,
+                                                    USHORT *actual, ULONG flags )
+{
+    TRACE( "(%p, %p, %lu, %p, %p, %#lx)\n", device, characteristic, size, value, actual, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!device)
+        return E_HANDLE;
+    if (!characteristic || !(size || value || actual) || (size && size < sizeof( *value )))
+        return E_INVALIDARG;
+    if (size && !value)
+        return E_POINTER;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTSetCharacteristicValue( HANDLE device, BTH_LE_GATT_CHARACTERISTIC *characteristic,
+                                                    BTH_LE_GATT_CHARACTERISTIC_VALUE *value,
+                                                    BTH_LE_GATT_RELIABLE_WRITE_CONTEXT context, ULONG flags )
+{
+    TRACE( "(%p, %p, %p, %s, %#lx)\n", device, characteristic, value,
+           wine_dbgstr_longlong( context ), flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!device)
+        return E_HANDLE;
+    if (!characteristic || !value)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTSetDescriptorValue( HANDLE device, BTH_LE_GATT_DESCRIPTOR *descriptor,
+                                                BTH_LE_GATT_DESCRIPTOR_VALUE *value,
+                                                BTH_LE_GATT_RELIABLE_WRITE_CONTEXT context, ULONG flags )
+{
+    TRACE( "(%p, %p, %p, %s, %#lx)\n", device, descriptor, value,
+           wine_dbgstr_longlong( context ), flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!device)
+        return E_HANDLE;
+    if (!descriptor || !value)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTRegisterEvent( HANDLE device, BTH_LE_GATT_EVENT_TYPE type, void *params,
+                                           PFNBLUETOOTH_GATT_EVENT_CALLBACK callback, void *context,
+                                           BLUETOOTH_GATT_EVENT_HANDLE *event_handle )
+{
+    TRACE( "(%p, %d, %p, %p, %p, %p)\n", device, type, params, callback, context, event_handle );
+
+    if (!event_handle)
+        return E_POINTER;
+    if (!callback)
+        return E_INVALIDARG;
+    if (!device)
+        return E_HANDLE;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTUnregisterEvent( BLUETOOTH_GATT_EVENT_HANDLE event_handle, ULONG flags )
+{
+    TRACE( "(%p, %#lx)\n", event_handle, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    /* Event handles are minted only by BluetoothGATTRegisterEvent, which
+       cannot succeed without an LE device stack. */
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
