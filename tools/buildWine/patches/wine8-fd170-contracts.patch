     FIXME( "(%p) - stub\n", handle );
     return TRUE;
 }
+
+/***********************************************************************
+ *           WinUsb device contract
+ *
+ * This runtime has no WinUSB device stack: no device can be driven by
+ * WinUSB, so no interface handle can ever be minted and every device
+ * handle fails WinUsb_Initialize the way a handle that does not belong
+ * to a WinUSB device fails it natively.  The functions validate their
+ * out-parameters first, in the native order, then report the invalid
+ * handle instead of raising the stub exception.
+ */
+
+/***********************************************************************
+ *           WinUsb_Initialize (winusb.@)
+ */
+BOOL WINAPI WinUsb_Initialize( HANDLE device_handle, PWINUSB_INTERFACE_HANDLE interface_handle )
+{
+    TRACE( "(%p, %p)\n", device_handle, interface_handle );
+
+    if (!interface_handle)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *interface_handle = NULL;
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetAssociatedInterface (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetAssociatedInterface( WINUSB_INTERFACE_HANDLE interface_handle, UCHAR index,
+                                           PWINUSB_INTERFACE_HANDLE associated_handle )
+{
+    TRACE( "(%p, %u, %p)\n", interface_handle, index, associated_handle );
+
+    if (!associated_handle)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *associated_handle = NULL;
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetOverlappedResult (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetOverlappedResult( WINUSB_INTERFACE_HANDLE interface_handle, OVERLAPPED *overlapped,
+                                        DWORD *transferred, BOOL wait )
+{
+    TRACE( "(%p, %p, %p, %d)\n", interface_handle, overlapped, transferred, wait );
+
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_ControlTransfer (winusb.@)
+ */
+BOOL WINAPI WinUsb_ControlTransfer( WINUSB_INTERFACE_HANDLE interface_handle, WINUSB_SETUP_PACKET setup,
+                                    UCHAR *buffer, ULONG length, ULONG *transferred, OVERLAPPED *overlapped )
+{
+    TRACE( "(%p, %p, %lu, %p, %p)\n", interface_handle, buffer, length, transferred, overlapped );
+
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_ReadPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_ReadPipe( WINUSB_INTERFACE_HANDLE interface_handle, UCHAR pipe_id, UCHAR *buffer,
+                             ULONG length, ULONG *transferred, OVERLAPPED *overlapped )
+{
+    TRACE( "(%p, %#x, %p, %lu, %p, %p)\n", interface_handle, pipe_id, buffer, length, transferred, overlapped );
+
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_WritePipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_WritePipe( WINUSB_INTERFACE_HANDLE interface_handle, UCHAR pipe_id, const UCHAR *buffer,
+                              ULONG length, ULONG *transferred, OVERLAPPED *overlapped )
+{
+    TRACE( "(%p, %#x, %p, %lu, %p, %p)\n", interface_handle, pipe_id, buffer, length, transferred, overlapped );
+
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_ResetPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_ResetPipe( WINUSB_INTERFACE_HANDLE interface_handle, UCHAR pipe_id )
+{
+    TRACE( "(%p, %#x)\n", interface_handle, pipe_id );
+
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_SetCurrentAlternateSetting (winusb.@)
+ */
+BOOL WINAPI WinUsb_SetCurrentAlternateSetting( WINUSB_INTERFACE_HANDLE interface_handle, UCHAR setting )
+{
+    TRACE( "(%p, %u)\n", interface_handle, setting );
+
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
