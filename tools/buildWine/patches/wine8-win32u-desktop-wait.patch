diff --git a/dlls/win32u/driver.c b/dlls/win32u/driver.c
index e2c9ba0..a52d518 100644
--- a/dlls/win32u/driver.c
+++ b/dlls/win32u/driver.c
@@ -935,6 +935,7 @@ static BOOL load_desktop_driver( HWND hwnd )
     HKEY hkey;
     DWORD size;
     UINT guid_atom;
+    unsigned int attempt;
 
     static const WCHAR prop_nameW[] =
         {'_','_','w','i','n','e','_','d','i','s','p','l','a','y','_','d','e','v','i','c','e',
@@ -943,47 +944,81 @@ static BOOL load_desktop_driver( HWND hwnd )
     user_check_not_lock();
 
     asciiz_to_unicode( driver_load_error, "The explorer process failed to start." );  /* default error */
-    /* wait for graphics driver to be ready */
-    send_message( hwnd, WM_NULL, 0, 0 );
-
-    guid_atom = HandleToULong( NtUserGetProp( hwnd, prop_nameW ));
-    memcpy( key, guid_key_prefixW, sizeof(guid_key_prefixW) );
-    ptr = key + ARRAYSIZE(guid_key_prefixW);
-    if (NtQueryInformationAtom( guid_atom, AtomBasicInformation, buf, sizeof(buf), NULL ))
-        return FALSE;
-    memcpy( ptr, abi->Name, abi->NameLength );
-    ptr += abi->NameLength / sizeof(WCHAR);
-    memcpy( ptr, guid_key_suffixW, sizeof(guid_key_suffixW) );
-    ptr += ARRAY_SIZE(guid_key_suffixW);
-
-    if (!(hkey = reg_open_key( NULL, key, (ptr - key) * sizeof(WCHAR) ))) return FALSE;
-
-    if ((size = query_reg_ascii_value( hkey, "GraphicsDriver", info, sizeof(buf) )))
+
+    if (!hwnd) return FALSE;
+
+    /* The desktop process publishes the display device guid (a
+     * property on the desktop window, set while the window is being
+     * created) and the GraphicsDriver registry value (written at the
+     * end of its own graphics driver initialization) only once its
+     * startup completes. When the machine is slow -- under emulation
+     * the desktop parade runs orders of magnitude slower than on
+     * hardware -- that publication can lag this process's first
+     * driver load by minutes. Falling back to the null driver on the
+     * first missing probe is permanent for the process: every window
+     * creation then fails, even though the desktop comes up fine
+     * moments later. Probe patiently until the driver (or a real
+     * driver error) is published; the first probe is unchanged, so a
+     * desktop that is already up costs nothing. */
+    for (attempt = 0; ; attempt++)
     {
-        static const WCHAR nullW[] = {'n','u','l','l',0};
-        TRACE( "trying driver %s\n", debugstr_wn( (const WCHAR *)info->Data,
-                                                  info->DataLength / sizeof(WCHAR) ));
-        if (info->DataLength != sizeof(nullW) || memcmp( info->Data, nullW, sizeof(nullW) ))
+        /* wait for graphics driver to be ready */
+        send_message( hwnd, WM_NULL, 0, 0 );
+
+        guid_atom = HandleToULong( NtUserGetProp( hwnd, prop_nameW ));
+        if (guid_atom)
         {
-            void *ret_ptr;
-            ULONG ret_len;
-            ret = KeUserModeCallback( NtUserLoadDriver, info->Data, info->DataLength,
-                                      &ret_ptr, &ret_len );
+            memcpy( key, guid_key_prefixW, sizeof(guid_key_prefixW) );
+            ptr = key + ARRAYSIZE(guid_key_prefixW);
+            if (!NtQueryInformationAtom( guid_atom, AtomBasicInformation, buf, sizeof(buf), NULL ))
+            {
+                memcpy( ptr, abi->Name, abi->NameLength );
+                ptr += abi->NameLength / sizeof(WCHAR);
+                memcpy( ptr, guid_key_suffixW, sizeof(guid_key_suffixW) );
+                ptr += ARRAY_SIZE(guid_key_suffixW);
+
+                if ((hkey = reg_open_key( NULL, key, (ptr - key) * sizeof(WCHAR) )))
+                {
+                    if ((size = query_reg_ascii_value( hkey, "GraphicsDriver", info, sizeof(buf) )))
+                    {
+                        static const WCHAR nullW[] = {'n','u','l','l',0};
+                        TRACE( "trying driver %s\n", debugstr_wn( (const WCHAR *)info->Data,
+                                                                  info->DataLength / sizeof(WCHAR) ));
+                        if (info->DataLength != sizeof(nullW) || memcmp( info->Data, nullW, sizeof(nullW) ))
+                        {
+                            void *ret_ptr;
+                            ULONG ret_len;
+                            ret = KeUserModeCallback( NtUserLoadDriver, info->Data, info->DataLength,
+                                                      &ret_ptr, &ret_len );
+                        }
+                        else
+                        {
+                            __wine_set_user_driver( &null_user_driver, WINE_GDI_DRIVER_VERSION );
+                            ret = TRUE;
+                        }
+                    }
+                    else if ((size = query_reg_ascii_value( hkey, "DriverError", info, sizeof(buf) )))
+                    {
+                        memcpy( driver_load_error, info->Data, min( info->DataLength, sizeof(driver_load_error) ));
+                        driver_load_error[ARRAYSIZE(driver_load_error) - 1] = 0;
+                    }
+                    NtClose( hkey );
+                    /* a named driver, or a driver error, is a
+                     * definitive answer; only a missing publication
+                     * is retried */
+                    if (size) return ret;
+                }
+            }
         }
-        else
+
+        if (attempt >= 600) break;
         {
-            __wine_set_user_driver( &null_user_driver, WINE_GDI_DRIVER_VERSION );
-            ret = TRUE;
+            LARGE_INTEGER interval;
+            interval.QuadPart = -500 * 10000;  /* 500 ms */
+            NtDelayExecution( FALSE, &interval );
         }
     }
-    else if ((size = query_reg_ascii_value( hkey, "DriverError", info, sizeof(buf) )))
-    {
-        memcpy( driver_load_error, info->Data, min( info->DataLength, sizeof(driver_load_error) ));
-        driver_load_error[ARRAYSIZE(driver_load_error) - 1] = 0;
-    }
-
-    NtClose( hkey );
-    return ret;
+    return FALSE;
 }
 
