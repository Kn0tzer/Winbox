diff --git a/dlls/win32u/winstation.c b/dlls/win32u/winstation.c
index 145e12a..a59da3a 100644
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -478,7 +478,18 @@ HWND get_desktop_window(void)
         {
             NtResumeThread( thread, NULL );
             TRACE_(win)( "started explorer\n" );
-            NtUserWaitForInputIdle( process, 10000, FALSE );
+            /* On a slow machine (under emulation the desktop process
+             * can need far longer than 10 s to finish initializing
+             * and go input idle) giving up here is fatal for the
+             * session: the forced get_desktop_window call below then
+             * fabricates a detached desktop window that the real
+             * desktop process can never adopt -- its own desktop
+             * window creation is refused as a non-desktop window --
+             * so the graphics driver is never published and every
+             * process latches the null driver permanently. Wait
+             * properly instead; the wait still returns at once if
+             * the desktop process exits. */
+            NtUserWaitForInputIdle( process, 300000, FALSE );
             NtClose( thread );
             NtClose( process );
         }
