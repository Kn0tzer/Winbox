+/***********************************************************************
+ *		SetupDiGetDeviceInterfaceAlias (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetDeviceInterfaceAlias(HDEVINFO devinfo, SP_DEVICE_INTERFACE_DATA *iface_data,
+        const GUID *alias_guid, SP_DEVICE_INTERFACE_DATA *alias_data)
+{
+    struct device_iface *iface, *alias;
+    struct device *device;
+
+    TRACE("%p, %p, %s, %p\n", devinfo, iface_data, debugstr_guid(alias_guid), alias_data);
+
+    if (!alias_guid || !alias_data || alias_data->cbSize != sizeof(*alias_data))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    if (!(iface = get_device_iface(devinfo, iface_data)))
+        return FALSE;
+
+    device = iface->device;
+    LIST_FOR_EACH_ENTRY(alias, &device->interfaces, struct device_iface, entry)
+    {
+        if (IsEqualGUID(&alias->class, alias_guid))
+        {
+            copy_device_iface_data(alias_data, alias);
+            return TRUE;
+        }
+    }
+
+    SetLastError(ERROR_NO_SUCH_DEVICE_INTERFACE);
+    return FALSE;
+}
+
