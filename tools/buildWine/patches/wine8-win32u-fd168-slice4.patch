index 573307c..61f6d2b 100644
--- a/dlls/win32u/wrappers.c
+++ b/dlls/win32u/wrappers.c
@@ -304,6 +304,23 @@ DWORD WINAPI NtGdiGetGlyphIndicesW( HDC hdc, const WCHAR *str, INT count,
     return unix_funcs->pNtGdiGetGlyphIndicesW( hdc, str, count, indices, flags );
 }
 
+DWORD WINAPI NtGdiGetGlyphIndicesWInternal( HDC hdc, const WCHAR *str, INT count,
+                                            WORD *indices, DWORD mode, BOOL subset )
+{
+    /* The public NtGdiGetGlyphIndicesW is this call with subset FALSE
+     * (ReactOS's public entry forwards to its Internal the same way),
+     * and ReactOS's font engine carries bSubset as an unimplemented
+     * FIXME, so the subset flag has no observable effect here either.
+     * The count checks are ReactOS's win32k-side validation, kept so
+     * the edge cases answer the same way with or without the flag. */
+    (void)subset;
+    if (count < 0) return GDI_ERROR;
+    if (!count && !str && !indices && !mode)
+        return NtGdiGetGlyphIndicesW( hdc, NULL, 0, NULL, 0 );
+    if (!count) return GDI_ERROR;
+    return NtGdiGetGlyphIndicesW( hdc, str, count, indices, mode );
+}
