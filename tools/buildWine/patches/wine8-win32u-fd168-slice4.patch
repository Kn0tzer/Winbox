@@ -368,6 +385,16 @@ BOOL WINAPI NtGdiGetTextExtentExW( HDC hdc, const WCHAR *str, INT count, INT max
     return unix_funcs->pNtGdiGetTextExtentExW( hdc, str, count, max_ext, nfit, dxs, size, flags );
 }
 
+BOOL WINAPI NtGdiGetTextExtent( HDC hdc, const WCHAR *str, INT count, SIZE *size, UINT flags )
+{
+    /* ReactOS's implementation is this exact call: the extent of the
+     * whole string is GetTextExtentExW with no fit limit, no per-char
+     * advances, and the caller's flags (0 for a character string, 1
+     * for glyph indices, the same values GetTextExtentPoint32W and
+     * GetTextExtentPointI pass). max_ext is unused when nfit is NULL. */
+    return NtGdiGetTextExtentExW( hdc, str, count, 0, NULL, NULL, size, flags );
+}
