 }
 
+/**********************************************************************
+ *           NtUserGetTopLevelWindow (win32u.@)
+ *
+ * The top-level window of a window is its root ancestor: the window
+ * itself when it is already top-level, else the ancestor just below
+ * the desktop. NtUserGetAncestor( hwnd, GA_ROOT ) computes exactly
+ * that walk, so this export is that call.
+ */
+HWND WINAPI NtUserGetTopLevelWindow( HWND hwnd )
+{
+    return NtUserGetAncestor( hwnd, GA_ROOT );
+}
+
 /**********************************************************************
  *           NtUserIsTopLevelWindow (win32u.@)
  */
