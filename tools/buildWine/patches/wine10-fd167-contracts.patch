+/***********************************************************************
+ *      MFCreateMediaBufferWrapper (mfplat.@)
+ */
+HRESULT WINAPI MFCreateMediaBufferWrapper(IMFMediaBuffer *buffer, DWORD offset, DWORD length,
+        IMFMediaBuffer **out)
+{
+    struct buffer_wrapper *wrapper;
+    DWORD max_length, current_length;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %lu, %p.\n", buffer, offset, length, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (!buffer)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IMFMediaBuffer_GetMaxLength(buffer, &max_length)))
+        return hr;
+    if (offset > max_length || length > max_length - offset)
+        return E_INVALIDARG;
+
+    if (!(wrapper = calloc(1, sizeof(*wrapper))))
+        return E_OUTOFMEMORY;
+
+    wrapper->IMFMediaBuffer_iface.lpVtbl = &buffer_wrapper_vtbl;
+    wrapper->IMF2DBuffer2_iface.lpVtbl = &buffer_wrapper_2d_vtbl;
+    wrapper->IMFDXGIBuffer_iface.lpVtbl = &buffer_wrapper_dxgi_vtbl;
+    wrapper->IMFGetService_iface.lpVtbl = &buffer_wrapper_service_vtbl;
+    wrapper->refcount = 1;
+    wrapper->inner = buffer;
+    IMFMediaBuffer_AddRef(buffer);
+    if (FAILED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMF2DBuffer2, (void **)&wrapper->inner_2d)))
+        wrapper->inner_2d = NULL;
+    if (FAILED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMFDXGIBuffer, (void **)&wrapper->inner_dxgi)))
+        wrapper->inner_dxgi = NULL;
+    if (FAILED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMFGetService, (void **)&wrapper->inner_service)))
+        wrapper->inner_service = NULL;
+    wrapper->offset = offset;
+    wrapper->max_length = length;
+    if (SUCCEEDED(IMFMediaBuffer_GetCurrentLength(buffer, &current_length)))
+        wrapper->current_length = current_length > offset
+                ? min(current_length - offset, length) : 0;
+    else
+        wrapper->current_length = 0;
+
+    *out = &wrapper->IMFMediaBuffer_iface;
+
+    TRACE("Created wrapper %p over buffer %p, offset %lu, length %lu.\n", wrapper, buffer, offset, length);
+
+    return S_OK;
+}
