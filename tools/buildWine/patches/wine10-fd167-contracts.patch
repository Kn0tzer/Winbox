+/******************************************************************
+ *  VariantCompare (propsys.@)
+ *
+ * The VARIANT counterpart of PropVariantCompareEx(): same -1/0/+1
+ * ordering with the default comparison unit and flags.  VARIANT and
+ * PROPVARIANT share their layout, so the Ex implementation does the
+ * work, except for the types it leaves unhandled (BOOL, DATE,
+ * FILETIME), which are ordered by value here first.
+ */
+INT WINAPI VariantCompare(const VARIANT *var1, const VARIANT *var2)
+{
+    if (var1->vt == var2->vt)
+    {
+        switch (var1->vt)
+        {
+        case VT_BOOL:
+            return (V_BOOL(var1) != VARIANT_FALSE) == (V_BOOL(var2) != VARIANT_FALSE)
+                    ? 0 : (V_BOOL(var1) != VARIANT_FALSE ? 1 : -1);
+        case VT_DATE:
+            if (V_DATE(var1) == V_DATE(var2)) return 0;
+            return V_DATE(var1) > V_DATE(var2) ? 1 : -1;
+        case VT_FILETIME:
+        {
+            ULARGE_INTEGER time1, time2;
+
+            /* VARIANT has no filetime union member; it shares its
+             * storage with the 8-byte date member. */
+            memcpy(&time1, &V_UNION(var1, date), sizeof(time1));
+            memcpy(&time2, &V_UNION(var2, date), sizeof(time2));
+            if (time1.QuadPart == time2.QuadPart) return 0;
+            return time1.QuadPart > time2.QuadPart ? 1 : -1;
+        }
+        default:
+            break;
+        }
+    }
+
+    return PropVariantCompareEx((const PROPVARIANT *)var1, (const PROPVARIANT *)var2,
+            PVCU_DEFAULT, PVCF_DEFAULT);
+}
+
 
