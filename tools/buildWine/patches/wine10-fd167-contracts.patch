+HRESULT WINAPI BluetoothGATTRegisterEvent( HANDLE, BTH_LE_GATT_EVENT_TYPE, void *, PFNBLUETOOTH_GATT_EVENT_CALLBACK, void *, BLUETOOTH_GATT_EVENT_HANDLE * );
