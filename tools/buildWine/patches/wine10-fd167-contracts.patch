+/***********************************************************************
+ *           WinUsb device contract
+ *
+ * This runtime has no WinUSB device stack: no device can be driven by
+ * WinUSB, so no interface handle can ever be minted and every device
+ * handle fails WinUsb_Initialize the way a handle that does not belong
+ * to a WinUSB device fails it natively.  The functions validate their
+ * out-parameters first, in the native order, then report the invalid
+ * handle instead of raising the stub exception.
+ */
+
+/***********************************************************************
+ *           WinUsb_Initialize (winusb.@)
+ */
+BOOL WINAPI WinUsb_Initialize( HANDLE device_handle, PWINUSB_INTERFACE_HANDLE interface_handle )
+{
+    TRACE( "(%p, %p)\n", device_handle, interface_handle );
+
+    if (!interface_handle)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *interface_handle = NULL;
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
