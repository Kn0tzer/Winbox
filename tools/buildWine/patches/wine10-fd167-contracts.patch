+/*********************************************************************
+ *  Bluetooth radio helpers
+ *
+ * This runtime has no Bluetooth radio stack: radio enumeration (via
+ * BluetoothFindFirstRadio/BluetoothFindNextRadio, which walk the
+ * setupapi device interfaces) is always empty here, so no handle a
+ * caller can hold names a radio, and no LE device handle can exist.
+ * The functions below still run the documented validation, in the same
+ * order as the native implementation, so callers get the answers a
+ * radio-less machine gives.
+ */
+
+static BOOL radio_handle_is_valid( HANDLE radio )
+{
+    BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof( params ) };
+    HBLUETOOTH_RADIO_FIND find;
+    HANDLE found = NULL;
+
+    find = BluetoothFindFirstRadio( &params, &found );
+    if (!find)
+        return FALSE;
+    for (;;)
+    {
+        HANDLE current = found;
+
+        if (current == radio)
+        {
+            CloseHandle( current );
+            BluetoothFindRadioClose( find );
+            return TRUE;
+        }
+        CloseHandle( current );
+        if (!BluetoothFindNextRadio( find, &found ))
+            break;
+    }
+    BluetoothFindRadioClose( find );
+    return FALSE;
+}
+
+/*********************************************************************
+ *  BluetoothEnableDiscovery
+ */
+BOOL WINAPI BluetoothEnableDiscovery( HANDLE radio, BOOL enable )
+{
+    TRACE( "(%p, %d)\n", radio, enable );
+
+    if (!radio)
+    {
+        /* A NULL radio means "every radio"; enumeration finds none. */
+        BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof( params ) };
+        HBLUETOOTH_RADIO_FIND find = BluetoothFindFirstRadio( &params, &radio );
+
+        if (!find)
+            return FALSE;
+        BluetoothFindRadioClose( find );
+        return FALSE;
+    }
+    if (!radio_handle_is_valid( radio ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    FIXME( "radio stack not available\n" );
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/*********************************************************************
+ *  BluetoothEnableIncomingConnections
+ */
+BOOL WINAPI BluetoothEnableIncomingConnections( HANDLE radio, BOOL enable )
+{
+    TRACE( "(%p, %d)\n", radio, enable );
+
+    if (!radio)
+    {
+        BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof( params ) };
+        HBLUETOOTH_RADIO_FIND find = BluetoothFindFirstRadio( &params, &radio );
+
+        if (!find)
+            return FALSE;
+        BluetoothFindRadioClose( find );
+        return FALSE;
+    }
+    if (!radio_handle_is_valid( radio ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    FIXME( "radio stack not available\n" );
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/*********************************************************************
+ *  BluetoothIsConnectable
+ */
+BOOL WINAPI BluetoothIsConnectable( HANDLE radio )
+{
+    TRACE( "(%p)\n", radio );
+
+    if (!radio)
+    {
+        BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof( params ) };
+        HBLUETOOTH_RADIO_FIND find = BluetoothFindFirstRadio( &params, &radio );
+
+        if (!find)
+            return FALSE;
+        BluetoothFindRadioClose( find );
+        /* No connectable radio can exist without a radio stack. */
+        return FALSE;
+    }
+    if (!radio_handle_is_valid( radio ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    return FALSE;
+}
+
+/*********************************************************************
+ *  Bluetooth GATT client functions
+ *
+ * Argument validation mirrors the native implementation's order.  The
+ * device step itself cannot succeed here: no Bluetooth LE device stack
+ * exists in this runtime, so no handle can name an LE device, and the
+ * native driver call fails for such a handle with ERROR_INVALID_HANDLE.
+ */
+
+HRESULT WINAPI BluetoothGATTGetServices( HANDLE device, USHORT count, BTH_LE_GATT_SERVICE *services,
+                                         USHORT *actual, ULONG flags )
+{
+    TRACE( "(%p, %u, %p, %p, %#lx)\n", device, count, services, actual, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!actual)
+        return E_POINTER;
+    if (!!services != !!count)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTGetCharacteristics( HANDLE device, BTH_LE_GATT_SERVICE *service, USHORT count,
+                                                BTH_LE_GATT_CHARACTERISTIC *characteristics, USHORT *actual,
+                                                ULONG flags )
+{
+    TRACE( "(%p, %p, %u, %p, %p, %#lx)\n", device, service, count, characteristics, actual, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!actual)
+        return E_POINTER;
+    if (characteristics && !count)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTGetDescriptors( HANDLE device, BTH_LE_GATT_CHARACTERISTIC *characteristic,
+                                            USHORT count, BTH_LE_GATT_DESCRIPTOR *descriptors, USHORT *actual,
+                                            ULONG flags )
+{
+    TRACE( "(%p, %p, %u, %p, %p, %#lx)\n", device, characteristic, count, descriptors, actual, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!actual)
+        return E_POINTER;
+    if (descriptors && !count)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTGetCharacteristicValue( HANDLE device, BTH_LE_GATT_CHARACTERISTIC *characteristic,
+                                                    ULONG size, BTH_LE_GATT_CHARACTERISTIC_VALUE *value,
+                                                    USHORT *actual, ULONG flags )
+{
+    TRACE( "(%p, %p, %lu, %p, %p, %#lx)\n", device, characteristic, size, value, actual, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!device)
+        return E_HANDLE;
+    if (!characteristic || !(size || value || actual) || (size && size < sizeof( *value )))
+        return E_INVALIDARG;
+    if (size && !value)
+        return E_POINTER;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTSetCharacteristicValue( HANDLE device, BTH_LE_GATT_CHARACTERISTIC *characteristic,
+                                                    BTH_LE_GATT_CHARACTERISTIC_VALUE *value,
+                                                    BTH_LE_GATT_RELIABLE_WRITE_CONTEXT context, ULONG flags )
+{
+    TRACE( "(%p, %p, %p, %s, %#lx)\n", device, characteristic, value,
+           wine_dbgstr_longlong( context ), flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!device)
+        return E_HANDLE;
+    if (!characteristic || !value)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTSetDescriptorValue( HANDLE device, BTH_LE_GATT_DESCRIPTOR *descriptor,
+                                                BTH_LE_GATT_DESCRIPTOR_VALUE *value,
+                                                BTH_LE_GATT_RELIABLE_WRITE_CONTEXT context, ULONG flags )
+{
+    TRACE( "(%p, %p, %p, %s, %#lx)\n", device, descriptor, value,
+           wine_dbgstr_longlong( context ), flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    if (!device)
+        return E_HANDLE;
+    if (!descriptor || !value)
+        return E_INVALIDARG;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTRegisterEvent( HANDLE device, BTH_LE_GATT_EVENT_TYPE type, void *params,
+                                           PFNBLUETOOTH_GATT_EVENT_CALLBACK callback, void *context,
+                                           BLUETOOTH_GATT_EVENT_HANDLE *event_handle )
+{
+    TRACE( "(%p, %d, %p, %p, %p, %p)\n", device, type, params, callback, context, event_handle );
+
+    if (!event_handle)
+        return E_POINTER;
+    if (!callback)
+        return E_INVALIDARG;
+    if (!device)
+        return E_HANDLE;
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
+
+HRESULT WINAPI BluetoothGATTUnregisterEvent( BLUETOOTH_GATT_EVENT_HANDLE event_handle, ULONG flags )
+{
+    TRACE( "(%p, %#lx)\n", event_handle, flags );
+
+    if (flags)
+        FIXME( "Unsupported flags: %#lx\n", flags );
+    /* Event handles are minted only by BluetoothGATTRegisterEvent, which
+       cannot succeed without an LE device stack. */
+    return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+}
