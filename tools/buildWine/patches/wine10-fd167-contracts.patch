     return create_1d_buffer(max_length, MF_1_BYTE_ALIGNMENT, buffer);
 }
 
+
+/***********************************************************************
+ *      Media buffer wrapper
+ *
+ * MFCreateMediaBufferWrapper() exposes a byte window of an existing
+ * buffer as a buffer of its own.  The wrapper delegates storage to the
+ * inner buffer: Lock() returns the inner pointer advanced by the
+ * window offset, lengths are the window's, and the optional 2D/DXGI/
+ * service interfaces are offered exactly when the inner buffer offers
+ * them, with returned pointers adjusted by the same offset.
+ */
+struct buffer_wrapper
+{
+    IMFMediaBuffer IMFMediaBuffer_iface;
+    IMF2DBuffer2 IMF2DBuffer2_iface;
+    IMFDXGIBuffer IMFDXGIBuffer_iface;
+    IMFGetService IMFGetService_iface;
+    LONG refcount;
+
+    IMFMediaBuffer *inner;
+    IMF2DBuffer2 *inner_2d;
+    IMFDXGIBuffer *inner_dxgi;
+    IMFGetService *inner_service;
+
+    DWORD offset;
+    DWORD max_length;
+    DWORD current_length;
+};
+
+static inline struct buffer_wrapper *impl_from_IMFMediaBuffer_wrapper(IMFMediaBuffer *iface)
+{
+    return CONTAINING_RECORD(iface, struct buffer_wrapper, IMFMediaBuffer_iface);
+}
+
+static inline struct buffer_wrapper *impl_from_IMF2DBuffer2_wrapper(IMF2DBuffer2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct buffer_wrapper, IMF2DBuffer2_iface);
+}
+
+static inline struct buffer_wrapper *impl_from_IMFDXGIBuffer_wrapper(IMFDXGIBuffer *iface)
+{
+    return CONTAINING_RECORD(iface, struct buffer_wrapper, IMFDXGIBuffer_iface);
+}
+
+static inline struct buffer_wrapper *impl_from_IMFGetService_wrapper(IMFGetService *iface)
+{
+    return CONTAINING_RECORD(iface, struct buffer_wrapper, IMFGetService_iface);
+}
+
+static HRESULT WINAPI buffer_wrapper_QueryInterface(IMFMediaBuffer *iface, REFIID riid, void **out)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMFMediaBuffer_wrapper(iface);
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFMediaBuffer) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = &wrapper->IMFMediaBuffer_iface;
+    }
+    else if ((IsEqualIID(riid, &IID_IMF2DBuffer) || IsEqualIID(riid, &IID_IMF2DBuffer2)) && wrapper->inner_2d)
+    {
+        *out = &wrapper->IMF2DBuffer2_iface;
+    }
+    else if (IsEqualIID(riid, &IID_IMFDXGIBuffer) && wrapper->inner_dxgi)
+    {
+        *out = &wrapper->IMFDXGIBuffer_iface;
+    }
+    else if (IsEqualIID(riid, &IID_IMFGetService) && wrapper->inner_service)
+    {
+        *out = &wrapper->IMFGetService_iface;
+    }
+    else
+    {
+        WARN("Unsupported %s.\n", debugstr_guid(riid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI buffer_wrapper_AddRef(IMFMediaBuffer *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMFMediaBuffer_wrapper(iface);
+    ULONG refcount = InterlockedIncrement(&wrapper->refcount);
+
+    TRACE("%p, refcount %lu.\n", wrapper, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI buffer_wrapper_Release(IMFMediaBuffer *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMFMediaBuffer_wrapper(iface);
+    ULONG refcount = InterlockedDecrement(&wrapper->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        if (wrapper->inner_2d)
+            IMF2DBuffer2_Release(wrapper->inner_2d);
+        if (wrapper->inner_dxgi)
+            IMFDXGIBuffer_Release(wrapper->inner_dxgi);
+        if (wrapper->inner_service)
+            IMFGetService_Release(wrapper->inner_service);
+        IMFMediaBuffer_Release(wrapper->inner);
+        free(wrapper);
+    }
+
+    return refcount;
+}
+
+static HRESULT WINAPI buffer_wrapper_Lock(IMFMediaBuffer *iface, BYTE **data, DWORD *max_length,
+        DWORD *current_length)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMFMediaBuffer_wrapper(iface);
+    BYTE *inner_data;
+    HRESULT hr;
+
+    TRACE("%p, %p %p, %p.\n", iface, data, max_length, current_length);
+
+    if (!data)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IMFMediaBuffer_Lock(wrapper->inner, &inner_data, NULL, NULL)))
+        return hr;
+
+    *data = inner_data + wrapper->offset;
+    if (max_length)
+        *max_length = wrapper->max_length;
+    if (current_length)
+        *current_length = wrapper->current_length;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_Unlock(IMFMediaBuffer *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMFMediaBuffer_wrapper(iface);
+
+    TRACE("%p.\n", iface);
+
+    return IMFMediaBuffer_Unlock(wrapper->inner);
+}
+
+static HRESULT WINAPI buffer_wrapper_GetCurrentLength(IMFMediaBuffer *iface, DWORD *current_length)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMFMediaBuffer_wrapper(iface);
+
+    TRACE("%p.\n", iface);
+
+    if (!current_length)
+        return E_INVALIDARG;
+
+    *current_length = wrapper->current_length;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_SetCurrentLength(IMFMediaBuffer *iface, DWORD current_length)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMFMediaBuffer_wrapper(iface);
+
+    TRACE("%p, %lu.\n", iface, current_length);
+
+    if (current_length > wrapper->max_length)
+        return E_INVALIDARG;
+
+    wrapper->current_length = current_length;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_GetMaxLength(IMFMediaBuffer *iface, DWORD *max_length)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMFMediaBuffer_wrapper(iface);
+
+    TRACE("%p, %p.\n", iface, max_length);
+
+    if (!max_length)
+        return E_INVALIDARG;
+
+    *max_length = wrapper->max_length;
+
+    return S_OK;
+}
+
+static const IMFMediaBufferVtbl buffer_wrapper_vtbl =
+{
+    buffer_wrapper_QueryInterface,
+    buffer_wrapper_AddRef,
+    buffer_wrapper_Release,
+    buffer_wrapper_Lock,
+    buffer_wrapper_Unlock,
+    buffer_wrapper_GetCurrentLength,
+    buffer_wrapper_SetCurrentLength,
+    buffer_wrapper_GetMaxLength,
+};
+
+static HRESULT WINAPI buffer_wrapper_2d_QueryInterface(IMF2DBuffer2 *iface, REFIID riid, void **out)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    return IMFMediaBuffer_QueryInterface(&wrapper->IMFMediaBuffer_iface, riid, out);
+}
+
+static ULONG WINAPI buffer_wrapper_2d_AddRef(IMF2DBuffer2 *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    return IMFMediaBuffer_AddRef(&wrapper->IMFMediaBuffer_iface);
+}
+
+static ULONG WINAPI buffer_wrapper_2d_Release(IMF2DBuffer2 *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    return IMFMediaBuffer_Release(&wrapper->IMFMediaBuffer_iface);
+}
+
+static HRESULT WINAPI buffer_wrapper_Lock2D(IMF2DBuffer2 *iface, BYTE **scanline0, LONG *pitch)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", iface, scanline0, pitch);
+
+    if (!wrapper->inner_2d)
+        return E_NOINTERFACE;
+
+    if (FAILED(hr = IMF2DBuffer_Lock2D(wrapper->inner_2d, scanline0, pitch)))
+        return hr;
+
+    if (scanline0)
+        *scanline0 += wrapper->offset;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_Unlock2D(IMF2DBuffer2 *iface)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+
+    TRACE("%p.\n", iface);
+
+    if (!wrapper->inner_2d)
+        return E_NOINTERFACE;
+
+    return IMF2DBuffer_Unlock2D(wrapper->inner_2d);
+}
+
+static HRESULT WINAPI buffer_wrapper_GetScanline0AndPitch(IMF2DBuffer2 *iface, BYTE **scanline0, LONG *pitch)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", iface, scanline0, pitch);
+
+    if (!wrapper->inner_2d)
+        return E_NOINTERFACE;
+
+    if (FAILED(hr = IMF2DBuffer_GetScanline0AndPitch(wrapper->inner_2d, scanline0, pitch)))
+        return hr;
+
+    if (scanline0)
+        *scanline0 += wrapper->offset;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_IsContiguousFormat(IMF2DBuffer2 *iface, BOOL *is_contiguous)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+
+    TRACE("%p, %p.\n", iface, is_contiguous);
+
+    if (!wrapper->inner_2d)
+        return E_NOINTERFACE;
+
+    return IMF2DBuffer_IsContiguousFormat(wrapper->inner_2d, is_contiguous);
+}
+
+static HRESULT WINAPI buffer_wrapper_GetContiguousLength(IMF2DBuffer2 *iface, DWORD *length)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    DWORD inner_length;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, length);
+
+    if (!wrapper->inner_2d)
+        return E_NOINTERFACE;
+    if (!length)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IMF2DBuffer_GetContiguousLength(wrapper->inner_2d, &inner_length)))
+        return hr;
+
+    *length = inner_length > wrapper->offset
+            ? min(inner_length - wrapper->offset, wrapper->max_length) : 0;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_ContiguousCopyTo(IMF2DBuffer2 *iface, BYTE *dest, DWORD dest_length)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("%p, %p, %lu.\n", iface, dest, dest_length);
+
+    if (!dest)
+        return E_INVALIDARG;
+    if (dest_length < wrapper->current_length)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IMFMediaBuffer_Lock(wrapper->inner, &data, NULL, NULL)))
+        return hr;
+    memcpy(dest, data + wrapper->offset, wrapper->current_length);
+    IMFMediaBuffer_Unlock(wrapper->inner);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_ContiguousCopyFrom(IMF2DBuffer2 *iface, const BYTE *src, DWORD src_length)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("%p, %p, %lu.\n", iface, src, src_length);
+
+    if (!src)
+        return E_INVALIDARG;
+    if (src_length > wrapper->max_length)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IMFMediaBuffer_Lock(wrapper->inner, &data, NULL, NULL)))
+        return hr;
+    memcpy(data + wrapper->offset, src, src_length);
+    IMFMediaBuffer_Unlock(wrapper->inner);
+    wrapper->current_length = src_length;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_Lock2DSize(IMF2DBuffer2 *iface, MF2DBuffer_LockFlags flags,
+        BYTE **scanline0, LONG *pitch, BYTE **start, DWORD *length)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    HRESULT hr;
+
+    TRACE("%p, %#x, %p, %p, %p, %p.\n", iface, flags, scanline0, pitch, start, length);
+
+    if (!wrapper->inner_2d)
+        return E_NOINTERFACE;
+
+    if (FAILED(hr = IMF2DBuffer2_Lock2DSize(wrapper->inner_2d, flags, scanline0, pitch, start, length)))
+        return hr;
+
+    if (scanline0)
+        *scanline0 += wrapper->offset;
+    if (start)
+        *start += wrapper->offset;
+    if (length)
+        *length = min(*length, wrapper->max_length);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_wrapper_Copy2DTo(IMF2DBuffer2 *iface, IMF2DBuffer2 *dest)
+{
+    struct buffer_wrapper *wrapper = impl_from_IMF2DBuffer2_wrapper(iface);
+    IMFMediaBuffer *dest_buffer;
+    BYTE *src_data, *dest_data;
+    DWORD count;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", iface, dest);
+
+    if (!dest)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IMF2DBuffer2_QueryInterface(dest, &IID_IMFMediaBuffer, (void **)&dest_buffer)))
+        return hr;
+
+    if (SUCCEEDED(hr = IMFMediaBuffer_Lock(wrapper->inner, &src_data, NULL, NULL)))
+    {
+        if (SUCCEEDED(hr = IMFMediaBuffer_Lock(dest_buffer, &dest_data, NULL, NULL)))
+        {
+            count = min(wrapper->current_length, wrapper->max_length);
+            memcpy(dest_data, src_data + wrapper->offset, count);
+            IMFMediaBuffer_Unlock(dest_buffer);
+        }
+        IMFMediaBuffer_Unlock(wrapper->inner);
+    }
+    IMFMediaBuffer_Release(dest_buffer);
+
+    return hr;
+}
