+/* FD-195: drop the retained last report (caller holds the PDO lock). */
+void hid_device_clear_last_report(DEVICE_OBJECT *device)
+{
+    BASE_DEVICE_EXTENSION *ext = device->DeviceExtension;
+
+    hid_report_decref( ext->u.pdo.last_report );
+    ext->u.pdo.last_report = NULL;
+}
