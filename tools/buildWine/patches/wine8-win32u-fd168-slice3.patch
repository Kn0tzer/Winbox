+/*******************************************************************
+ *           NtUserWindowFromPhysicalPoint (win32u.@)
+ *
+ * Physical points share the logical coordinate space in this
+ * driver model (the tree's LogicalToPhysicalPoint and
+ * PhysicalToLogicalPoint are the identity mapping), so the hit
+ * test is NtUserWindowFromPoint itself.
+ */
+HWND WINAPI NtUserWindowFromPhysicalPoint( POINT pt )
+{
+    return NtUserWindowFromPoint( pt.x, pt.y );
+}
