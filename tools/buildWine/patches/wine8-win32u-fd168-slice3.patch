 }
 
+BOOL WINAPI NtGdiPolyPatBlt( HDC hdc, DWORD rop, const POLYPATBLT *p, DWORD count, DWORD mode )
+{
+    HGDIOBJ prev_brush;
+    DWORD i;
+
+    if (!unix_funcs) return FALSE;
+    if (count && !unix_funcs->pNtGdiGetDeviceCaps( hdc, HORZRES )) return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        if (!(prev_brush = unix_funcs->pNtGdiSelectBrush( hdc, p[i].hBrush ))) continue;
+        unix_funcs->pNtGdiPatBlt( hdc, p[i].nXLeft, p[i].nYLeft, p[i].nWidth, p[i].nHeight, rop );
+        unix_funcs->pNtGdiSelectBrush( hdc, prev_brush );
+    }
+    return TRUE;
+}
