+ */
+_Fcomplex CDECL _FCmulcc(_Fcomplex a, _Fcomplex b)
+{
+    _Fcomplex ret;
+    ret._Val[0] = a._Val[0] * b._Val[0] - a._Val[1] * b._Val[1];
+    ret._Val[1] = a._Val[0] * b._Val[1] + a._Val[1] * b._Val[0];
+    return ret;
