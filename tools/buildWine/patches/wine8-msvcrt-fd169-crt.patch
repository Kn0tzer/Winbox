+/*********************************************************************
+ *		_cprintf_p_l (MSVCRT.@)
+ */
+int WINAPIV _cprintf_p_l(const char* format, _locale_t locale, ...)
+{
+    va_list valist;
+    int res;
+
+    va_start(valist, locale);
+    res = _vcprintf_p_l(format, locale, valist);
+    va_end(valist);
+    return res;
