+/*********************************************************************
+ *		_getws_s (MSVCRT.@)
+ */
+wchar_t* CDECL _getws_s(wchar_t *str, size_t size)
+{
+    size_t len;
+
+    if (!MSVCRT_CHECK_PMT(str != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(size != 0)) return NULL;
+
+    if (!fgetws(str, size, MSVCRT_stdin))
+        return NULL;
+
+    len = wcslen(str);
+    if (len && str[len - 1] == '\n')
+    {
+        str[--len] = 0;
+        if (len && str[len - 1] == '\r')
+            str[--len] = 0;
+        return str;
+    }
+    if (len == size - 1 && !feof(MSVCRT_stdin))
+    {
+        /* the line does not fit: drain the rest and fail like the
+         * secure CRT does (invalid parameter handler, NULL result) */
+        int ch;
+        while ((ch = fgetwc(MSVCRT_stdin)) != WEOF && ch != '\n')
+            ;
+        *str = 0;
+        if (!MSVCRT_CHECK_PMT_ERR(FALSE, ERANGE)) return NULL;
+    }
+    return str;
+}
