+    const unsigned char *cur = (const unsigned char *)str;
+    const unsigned char *end = cur + maxsize;
+    size_t len = 0;
+
+    while (cur < end && *cur)
+    {
+        const unsigned char *next = _mbsinc_l(cur, locale);
+        if (next > end)
+            break;
+        cur = next;
+        len++;
+    }
+    return len;
