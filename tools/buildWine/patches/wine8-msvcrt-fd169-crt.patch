+/***********************************************************************
+ * FD-169 hand implementations: the MSVC complex helper functions
+ * (_Cmulcc and family) and the C99 complex arithmetic set that Wine
+ * 8.0 ships as spec stubs in ucrtbase/msvcr120.
+ *
+ * The "l" (long double) variants use the MSVC ABI layout: in MSVC a
+ * long double is the same 64-bit type as double, so an MSVC
+ * _Lcomplex is a pair of doubles. Wine's own long double is the
+ * 80-bit x87 type, so these functions are written against an explicit
+ * double-pair struct to match the guest-visible layout exactly.
+ *
+ * Formulas are the standard principal-value definitions (C99 7.3 /
+ * Annex G), the same semantics MSVC documents for <complex>.
+ */
+typedef struct
+{
+    double _Val[2];
+} _Lcomplex; /* MSVC layout: long double == double */
+
+static _Dcomplex cx_make(double re, double im)
+{
+    _Dcomplex ret;
+    ret._Val[0] = re;
+    ret._Val[1] = im;
+    return ret;
+}
+
+static _Dcomplex cx_mul(_Dcomplex a, _Dcomplex b)
+{
+    return cx_make(a._Val[0] * b._Val[0] - a._Val[1] * b._Val[1],
+                   a._Val[0] * b._Val[1] + a._Val[1] * b._Val[0]);
+}
+
+static _Dcomplex cx_div(_Dcomplex a, _Dcomplex b)
+{
+    double denom = b._Val[0] * b._Val[0] + b._Val[1] * b._Val[1];
+    return cx_make((a._Val[0] * b._Val[0] + a._Val[1] * b._Val[1]) / denom,
+                   (a._Val[1] * b._Val[0] - a._Val[0] * b._Val[1]) / denom);
+}
+
+static _Dcomplex cx_log(_Dcomplex z)
+{
+    return cx_make(log(hypot(z._Val[0], z._Val[1])), atan2(z._Val[1], z._Val[0]));
+}
+
+static _Dcomplex cx_exp(_Dcomplex z)
+{
+    double e = exp(z._Val[0]);
+    return cx_make(e * cos(z._Val[1]), e * sin(z._Val[1]));
+}
+
+static _Dcomplex cx_sqrt(_Dcomplex z)
+{
+    double x = z._Val[0], y = z._Val[1], r = hypot(x, y), t;
+
+    if (r == 0)
+        return cx_make(0, 0);
+    if (x >= 0)
+    {
+        t = sqrt((r + x) / 2);
+        return cx_make(t, y / (2 * t));
+    }
+    t = sqrt((r - x) / 2);
+    return cx_make(fabs(y) / (2 * t), _copysign(t, y));
+}
