+/***********************************************************************
+ * FD-169 hand implementations: the 32-bit-time / 64-bit-size finddata
+ * variants, translated exactly like the existing 32-bit forms except
+ * that the file size keeps both halves.
+ */
+
+/* INTERNAL: Translate WIN32_FIND_DATAA to finddata32i64_t  */
+static void msvcrt_fttofd32i64( const WIN32_FIND_DATAA *fd, struct _finddata32i64_t* ft)
+{
+  DWORD dw;
+
+  if (fd->dwFileAttributes == FILE_ATTRIBUTE_NORMAL)
+    ft->attrib = 0;
+  else
+    ft->attrib = fd->dwFileAttributes;
+
+  RtlTimeToSecondsSince1970( (const LARGE_INTEGER *)&fd->ftCreationTime, &dw );
+  ft->time_create = dw;
+  RtlTimeToSecondsSince1970( (const LARGE_INTEGER *)&fd->ftLastAccessTime, &dw );
+  ft->time_access = dw;
+  RtlTimeToSecondsSince1970( (const LARGE_INTEGER *)&fd->ftLastWriteTime, &dw );
+  ft->time_write = dw;
+  ft->size = ((__int64)fd->nFileSizeHigh << 32) | fd->nFileSizeLow;
+  strcpy(ft->name, fd->cFileName);
+}
+
+/* INTERNAL: Translate WIN32_FIND_DATAW to wfinddata32i64_t  */
+static void msvcrt_wfttofd32i64( const WIN32_FIND_DATAW *fd, struct _wfinddata32i64_t* ft)
+{
+  DWORD dw;
+
+  if (fd->dwFileAttributes == FILE_ATTRIBUTE_NORMAL)
+    ft->attrib = 0;
+  else
+    ft->attrib = fd->dwFileAttributes;
+
+  RtlTimeToSecondsSince1970( (const LARGE_INTEGER *)&fd->ftCreationTime, &dw );
+  ft->time_create = dw;
+  RtlTimeToSecondsSince1970( (const LARGE_INTEGER *)&fd->ftLastAccessTime, &dw );
+  ft->time_access = dw;
+  RtlTimeToSecondsSince1970( (const LARGE_INTEGER *)&fd->ftLastWriteTime, &dw );
+  ft->time_write = dw;
+  ft->size = ((__int64)fd->nFileSizeHigh << 32) | fd->nFileSizeLow;
+  wcscpy(ft->name, fd->cFileName);
+}
+
+/*********************************************************************
+ *		_findfirst32i64 (MSVCRT.@)
+ */
+intptr_t CDECL _findfirst32i64(const char * fspec, struct _finddata32i64_t* ft)
+{
+  WIN32_FIND_DATAA find_data;
+  HANDLE hfind;
+
+  hfind  = FindFirstFileA(fspec, &find_data);
+  if (hfind == INVALID_HANDLE_VALUE)
+  {
+    msvcrt_set_errno(GetLastError());
+    return -1;
+  }
+  msvcrt_fttofd32i64(&find_data,ft);
+  TRACE(":got handle %p\n",hfind);
+  return (intptr_t)hfind;
+}
+
+/*********************************************************************
+ *		_findnext32i64 (MSVCRT.@)
+ */
+int CDECL _findnext32i64(intptr_t handle, struct _finddata32i64_t* ft)
