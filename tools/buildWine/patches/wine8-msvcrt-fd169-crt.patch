+/***********************************************************************
+ * FD-169 hand implementations: _ismbb* byte classification, _ismbcblank,
+ * _mbsncoll/_mbsnicoll, the _s string setters, _mbstrnlen, _mbsstr_l,
+ * _mbsninc_l and __p__mbcasemap.
+ *
+ * The _ismbb* definitions are the ones Microsoft documents for the
+ * family (MS Learn, "Return value" expressions): each is the single-byte
+ * ctype test OR-ed with the corresponding kana test, where the kana
+ * tests are bit tests on the same mbctype table Wine builds for the
+ * locale (the _MS/_MP bits are set for code page 932 only, exactly as
+ * in MSVC: _MP for bytes 0xA1-0xA5, _MS for 0xA6-0xDF).
+ */
+
+/*********************************************************************
+ *		_ismbbkalnum_l (MSVCRT.@)
+ */
+int CDECL _ismbbkalnum_l(unsigned int c, _locale_t locale)
+{
+    pthreadmbcinfo mbcinfo;
+
+    if (c > 0xff)
+        return 0;
+    if (locale)
+        mbcinfo = locale->mbcinfo;
+    else
+        mbcinfo = get_mbcinfo();
+    return (mbcinfo->mbctype[c + 1] & _MS) != 0;
+}
+
+/*********************************************************************
+ *		_ismbbkalnum (MSVCRT.@)
+ */
+int CDECL _ismbbkalnum(unsigned int c)
+{
+    return _ismbbkalnum_l(c, NULL);
+}
