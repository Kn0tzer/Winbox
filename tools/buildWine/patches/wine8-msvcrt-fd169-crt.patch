+/*********************************************************************
+ *		_mbsncat_s_l (MSVCRT.@)
+ */
+errno_t CDECL _mbsncat_s_l(unsigned char *dst, size_t maxsize, const unsigned char *src,
+        size_t count, _locale_t locale)
+{
+    BOOL truncate = (count == _TRUNCATE);
+    unsigned char *start = dst;
+    const unsigned char *p;
+    size_t dstlen, srclen = 0, copied = 0, n = count;
+    pthreadmbcinfo mbcinfo;
+
+    if (!MSVCRT_CHECK_PMT(dst != NULL)) return EINVAL;
+    if (!MSVCRT_CHECK_PMT(maxsize != 0)) return EINVAL;
+    if (!MSVCRT_CHECK_PMT(src != NULL))
+    {
+        *start = 0;
+        return EINVAL;
+    }
+
+    dstlen = strnlen((const char *)dst, maxsize);
+    if (!MSVCRT_CHECK_PMT(dstlen < maxsize))
+        return EINVAL;
+
+    if (locale)
+        mbcinfo = locale->mbcinfo;
+    else
+        mbcinfo = get_mbcinfo();
+
+    /* byte length of the first count characters of src */
+    p = src;
+    while (n && *p)
+    {
+        p = _mbsinc_l(p, locale);
+        n--;
+    }
+    srclen = p - src;
+
+    if (dstlen + srclen >= maxsize && !truncate)
+    {
+        *start = 0;
+        if (!MSVCRT_CHECK_PMT_ERR(FALSE, ERANGE)) return ERANGE;
+    }
+
+    dst += dstlen;
+    maxsize -= dstlen;
+    while (copied < srclen && maxsize > 1)
+    {
+        unsigned int curlen;
+        if (mbcinfo->ismbcodepage && _ismbblead_l(src[copied], locale))
+        {
+            if (copied + 1 >= srclen)
+                break; /* never split a character at the boundary */
+            curlen = 2;
+        }
+        else
+            curlen = 1;
+        if (curlen > maxsize - 1)
+            break;
+        *dst++ = src[copied++];
+        if (curlen == 2)
+            *dst++ = src[copied++];
+        maxsize -= curlen;
+    }
+    *dst = 0;
+
+    if (copied < srclen)
+        return truncate ? STRUNCATE : ERANGE;
+    return 0;
+}
+
+/*********************************************************************
+ *		_mbsncat_s (MSVCRT.@)
+ */
+errno_t CDECL _mbsncat_s(unsigned char *dst, size_t maxsize, const unsigned char *src, size_t count)
+{
+    return _mbsncat_s_l(dst, maxsize, src, count, NULL);
+}
