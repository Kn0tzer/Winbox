+/***********************************************************************
+ * FD-169 hand implementation: _lsearch_s, the context-passing form of
+ * _lsearch (same insertion semantics: a missing key is appended and
+ * the element count incremented).
+ */
+
+/*********************************************************************
+ *		_lsearch_s (MSVCRT.@)
+ */
+void* CDECL _lsearch_s(const void* match, void* start,
+                     unsigned int* array_size, unsigned int elem_size,
+                     int (CDECL *cf)(void*, const void*, const void*),
+                     void* context)
+{
+  unsigned int size;
+
+  if (!MSVCRT_CHECK_PMT(match != NULL)) return NULL;
+  if (!MSVCRT_CHECK_PMT(start != NULL)) return NULL;
+  if (!MSVCRT_CHECK_PMT(array_size != NULL)) return NULL;
+  if (!MSVCRT_CHECK_PMT(cf != NULL)) return NULL;
+  size = *array_size;
+
+  if (size)
+    do
+    {
+      if (cf(context, match, start) == 0)
+        return start; /* found */
+      start = (char*)start + elem_size;
+    } while (--size);
+
+  /* not found: insert at the end */
+  memcpy(start, match, elem_size);
+  *array_size += 1;
+  return start;
+}
