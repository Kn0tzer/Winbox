+     * byte length of the longer of the two prefixes, so the bounded
+     * byte compare sees both strings' first count characters. */
+    const unsigned char *p1 = str1, *p2 = str2;
+    size_t bytes, n = count;
+
+    while (n && *p1)
+    {
+        p1 = _mbsinc_l(p1, locale);
+        n--;
+    }
+    n = count;
+    while (n && *p2)
+    {
+        p2 = _mbsinc_l(p2, locale);
+        n--;
+    }
+    bytes = (p1 - str1) > (p2 - str2) ? (p1 - str1) : (p2 - str2);
+    return _mbsnbcoll_l(str1, str2, bytes, locale);
+}
