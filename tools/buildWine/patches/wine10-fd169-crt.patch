+/*********************************************************************
+ *		_findfirst32i64 (MSVCRT.@)
+ */
+intptr_t CDECL _findfirst32i64(const char * fspec, struct _finddata32i64_t* ft)
+{
+  WIN32_FIND_DATAA find_data;
+  HANDLE hfind;
+
+  hfind  = FindFirstFileA(fspec, &find_data);
+  if (hfind == INVALID_HANDLE_VALUE)
+  {
+    msvcrt_set_errno(GetLastError());
+    return -1;
+  }
+  msvcrt_fttofd32i64(&find_data,ft);
+  TRACE(":got handle %p\n",hfind);
+  return (intptr_t)hfind;
+}
