+ * locale; returns the number of bytes consumed, 0 for the null
+ * character, -1 on an invalid sequence (errno set to EILSEQ) and -2
+ * for an incomplete sequence. Wide output goes to out (up to two
+ * UTF-16 units, *outlen receives their number). */
+static int fd169_decode_wide(WCHAR *out, int *outlen, const char *str, size_t len)
+{
+    pthreadlocinfo locinfo = get_locinfo();
+    size_t n;
+    int ret;
+
+    *outlen = 0;
+    if (!len)
+        return -2;
+    if (!*str)
+    {
+        out[0] = 0;
+        *outlen = 1;
+        return 0;
+    }
+    if (!locinfo->lc_codepage)
+    {
+        out[0] = (unsigned char)*str;
+        *outlen = 1;
+        return 1;
+    }
+    for (n = 1; n <= len; n++)
+    {
+        ret = MultiByteToWideChar(locinfo->lc_codepage, MB_ERR_INVALID_CHARS,
+                str, n, out, 2);
+        if (ret > 0)
+        {
+            *outlen = ret;
+            return n;
+        }
+        if (n == len)
+            break;
+        /* a longer prefix may still decode (multibyte sequence) */
+        if (!isleadbyte((unsigned char)*str) && locinfo->lc_codepage != CP_UTF8)
+            break;
+    }
+    /* distinguish an incomplete sequence (valid so far, needs more
+     * bytes) from an invalid one */
+    if (locinfo->lc_codepage == CP_UTF8)
+    {
+        unsigned char c = (unsigned char)*str;
+        size_t need = (c >= 0xf0) ? 4 : (c >= 0xe0) ? 3 : (c >= 0xc0) ? 2 : 1;
+        size_t i;
+        BOOL prefix_ok = len < need;
+        for (i = 1; prefix_ok && i < len && i < need; i++)
+            if (((unsigned char)str[i] & 0xc0) != 0x80)
+                prefix_ok = FALSE;
+        if (prefix_ok && len < need)
+            return -2;
+    }
+    else if (isleadbyte((unsigned char)*str) && len == 1)
+        return -2;
+    *_errno() = EILSEQ;
+    return -1;
+}
+
+/*********************************************************************
+ *		mbrtoc16 (MSVCRT.@)
+ */
+size_t CDECL mbrtoc16(WCHAR *c16, const char *str, size_t len, mbstate_t *state)
+{
+    WCHAR out[2];
+    int outlen, pending, ret;
+
+    if (!str)
+    {
+        if (state) *state = 0;
+        return 0;
+    }
+    pending = fd169_pending_surrogate(state);
+    if (pending)
+    {
+        if (state) *state = 0;
+        if (c16) *c16 = pending;
+        return (size_t)-3;
+    }
+    ret = fd169_decode_wide(out, &outlen, str, len);
+    if (ret > 0)
+    {
+        if (c16) *c16 = out[0];
+        if (outlen == 2 && state)
+            *state = out[1];
+    }
+    else if (ret == 0 && c16)
+        *c16 = 0;
+    return ret;
+}
+
+/*********************************************************************
+ *		mbrtoc32 (MSVCRT.@)
+ */
+size_t CDECL mbrtoc32(unsigned int *c32, const char *str, size_t len, mbstate_t *state)
+{
+    WCHAR out[2];
+    int outlen, ret;
+
+    if (!str)
+    {
+        if (state) *state = 0;
+        return 0;
+    }
+    ret = fd169_decode_wide(out, &outlen, str, len);
+    if (ret >= 0 && c32)
+    {
+        if (outlen == 2)
+            *c32 = 0x10000 + ((out[0] - 0xd800) << 10) + (out[1] - 0xdc00);
+        else if (outlen == 1)
+            *c32 = out[0];
+        else
+            *c32 = 0;
+    }
+    return ret;
+}
+
+/*********************************************************************
+ *		c16rtomb (MSVCRT.@)
+ */
+size_t CDECL c16rtomb(char *str, WCHAR c16, mbstate_t *state)
+{
+    pthreadlocinfo locinfo = get_locinfo();
+    WCHAR pair[2];
+    int pending, len;
+
+    if (!str)
+    {
+        /* equivalent to a call with a null character and a scratch
+         * buffer: resets the state, and fails if a high surrogate
+         * is still pending */
+        char buf[8];
+        return c16rtomb(buf, 0, state);
+    }
+
+    pending = state ? *state : 0;
+    if (pending >= 0xd800 && pending <= 0xdbff)
+    {
+        if (state) *state = 0;
+        if (c16 < 0xdc00 || c16 > 0xdfff)
+        {
+            *_errno() = EILSEQ;
+            return (size_t)-1;
+        }
+        pair[0] = pending;
+        pair[1] = c16;
+        len = WideCharToMultiByte(locinfo->lc_codepage, 0, pair, 2,
+                str, locinfo->mb_cur_max * 2, NULL, NULL);
+        if (!len)
+        {
+            *_errno() = EILSEQ;
+            return (size_t)-1;
+        }
+        return len;
+    }
+
+    if (c16 >= 0xd800 && c16 <= 0xdbff)
+    {
+        if (state) *state = c16;
+        return 0;
+    }
+    if (c16 >= 0xdc00 && c16 <= 0xdfff)
+    {
+        *_errno() = EILSEQ;
+        return (size_t)-1;
+    }
+    if (!locinfo->lc_codepage)
+    {
+        if (c16 > 0xff)
+        {
+            *_errno() = EILSEQ;
+            return (size_t)-1;
+        }
+        *str = (char)c16;
+        return c16 != 0;
+    }
+    len = WideCharToMultiByte(locinfo->lc_codepage, 0, &c16, 1,
+            str, locinfo->mb_cur_max, NULL, NULL);
+    if (!len)
+    {
+        *_errno() = EILSEQ;
+        return (size_t)-1;
+    }
+    if (c16 == 0)
+        return 0;
+    return len;
+}
+
+/*********************************************************************
+ *		c32rtomb (MSVCRT.@)
+ */
+size_t CDECL c32rtomb(char *str, unsigned int c32, mbstate_t *state)
+{
+    WCHAR pair[2];
+    int count;
+
+    if (!str)
+    {
+        if (state) *state = 0;
+        return 0;
+    }
+    if (state) *state = 0;
+    if (c32 > 0x10ffff || (c32 >= 0xd800 && c32 <= 0xdfff))
+    {
+        *_errno() = EILSEQ;
+        return (size_t)-1;
+    }
+    if (c32 < 0x10000)
+    {
+        pair[0] = (WCHAR)c32;
+        count = 1;
+    }
+    else
+    {
+        c32 -= 0x10000;
+        pair[0] = 0xd800 + (c32 >> 10);
+        pair[1] = 0xdc00 + (c32 & 0x3ff);
+        count = 2;
+    }
+    if (count == 1)
+        return c16rtomb(str, pair[0], &(mbstate_t){0});
+    {
+        pthreadlocinfo locinfo = get_locinfo();
+        int len = WideCharToMultiByte(locinfo->lc_codepage, 0, pair, 2,
+                str, locinfo->mb_cur_max * 2, NULL, NULL);
+        if (!len)
+        {
+            *_errno() = EILSEQ;
+            return (size_t)-1;
+        }
+        return len;
+    }
+}
+
+/*********************************************************************
+ *		__wcsncnt (MSVCRT.@)
+ */
+size_t CDECL __wcsncnt(const wchar_t *str, size_t count)
+{
+    size_t n = 0;
+    while (n < count && str[n])
+        n++;
+    return n;
+}
