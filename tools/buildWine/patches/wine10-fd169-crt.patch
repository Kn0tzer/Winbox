+ * do not link that archive member), so the complex code uses these
+ * local bit-level forms (the musl copysign semantics). */
+static inline double fd169_copysign(double x, double y)
+{
+    union { double f; unsigned long long i; } ux = { x }, uy = { y };
+    ux.i = (ux.i & 0x7fffffffffffffffULL) | (uy.i & 0x8000000000000000ULL);
+    return ux.f;
+}
+static inline float fd169_copysignf(float x, float y)
+{
+    union { float f; unsigned int i; } ux = { x }, uy = { y };
+    ux.i = (ux.i & 0x7fffffffU) | (uy.i & 0x80000000U);
+    return ux.f;
