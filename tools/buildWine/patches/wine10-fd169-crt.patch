+    {
+        p1 = _mbsinc_l(p1, locale);
+        n--;
+    }
+    n = count;
+    while (n && *p2)
+    {
+        p2 = _mbsinc_l(p2, locale);
+        n--;
+    }
+    bytes = (p1 - str1) > (p2 - str2) ? (p1 - str1) : (p2 - str2);
+    return _mbsnbcoll_l(str1, str2, bytes, locale);
