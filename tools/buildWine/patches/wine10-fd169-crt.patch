+/*********************************************************************
+ *		_cgets_s (MSVCRT.@)
+ */
+char* CDECL _cgets_s(char *buffer, size_t size, size_t *num_read)
+{
+    size_t len = 0;
+    int c;
+
+    if (!MSVCRT_CHECK_PMT(buffer != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(size != 0)) return NULL;
+    if (!MSVCRT_CHECK_PMT(num_read != NULL)) return NULL;
+
+    for (;;)
+    {
+        c = _getche();
+        if (c == EOF)
+        {
+            if (!len)
+            {
+                *num_read = 0;
+                buffer[0] = 0;
+                return NULL;
+            }
+            break;
+        }
+        if (c == '\r' || c == '\n')
+        {
+            _putch('\n');
+            break;
+        }
+        if (c == '\b')
+        {
+            if (len)
+            {
+                len--;
+                _putch(' ');
+                _putch('\b');
+            }
+            continue;
+        }
+        if (len + 1 >= size)
+        {
+            /* drain the rest of the line and fail like the secure CRT */
+            while ((c = _getch()) != EOF && c != '\r' && c != '\n')
+                ;
+            buffer[0] = 0;
+            *num_read = 0;
+            *_errno() = ERANGE;
+            return NULL;
+        }
+        buffer[len++] = (char)c;
+    }
+    buffer[len] = 0;
+    *num_read = len;
+    return buffer;
+}
+
+/*********************************************************************
+ *		_cgetws_s (MSVCRT.@)
+ */
+wchar_t* CDECL _cgetws_s(wchar_t *buffer, size_t size, size_t *num_read)
+{
+    size_t len = 0;
+    wint_t c;
+
+    if (!MSVCRT_CHECK_PMT(buffer != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(size != 0)) return NULL;
+    if (!MSVCRT_CHECK_PMT(num_read != NULL)) return NULL;
+
+    for (;;)
+    {
+        c = _getwche();
+        if (c == WEOF)
+        {
+            if (!len)
+            {
+                *num_read = 0;
+                buffer[0] = 0;
+                return NULL;
+            }
+            break;
+        }
+        if (c == '\r' || c == '\n')
+        {
+            _putwch('\n');
+            break;
+        }
+        if (c == '\b')
+        {
+            if (len)
+            {
+                len--;
+                _putwch(' ');
+                _putwch('\b');
+            }
+            continue;
+        }
+        if (len + 1 >= size)
+        {
+            while ((c = _getwch()) != WEOF && c != '\r' && c != '\n')
+                ;
+            buffer[0] = 0;
+            *num_read = 0;
+            *_errno() = ERANGE;
+            return NULL;
+        }
+        buffer[len++] = (wchar_t)c;
+    }
+    buffer[len] = 0;
+    *num_read = len;
+    return buffer;
+}
+
+/*********************************************************************
+ *		_cgetws (MSVCRT.@)
+ */
+wchar_t* CDECL _cgetws(wchar_t *buffer)
+{
+    size_t num_read = 0;
+    wchar_t *ret;
+
+    if (!MSVCRT_CHECK_PMT(buffer != NULL)) return NULL;
+
+    /* legacy form: buffer[0] holds the maximum length on entry and
+     * buffer[1] the actual length; the string starts at buffer + 2 */
+    ret = _cgetws_s(buffer + 2, (size_t)buffer[0] + 1, &num_read);
+    if (!ret)
+    {
+        buffer[1] = 0;
+        return NULL;
+    }
+    buffer[1] = (wchar_t)num_read;
+    return buffer + 2;
+}
