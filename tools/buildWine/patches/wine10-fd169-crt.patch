+/***********************************************************************
+ * FD-169 hand implementations: the positional (_p) and secure (_s)
+ * console printf forms (same engine flags as the __stdio_common_*
+ * family), the __conio_common _p/_s variants, and the console line
+ * input functions _cgets_s/_cgetws/_cgetws_s.
+ */
+
+/*********************************************************************
+ *		_vcprintf_p_l (MSVCRT.@)
+ */
+int CDECL _vcprintf_p_l(const char* format, _locale_t locale, va_list valist)
+{
+    return pf_printf_a(puts_clbk_console_a, NULL, format, locale,
+            MSVCRT_PRINTF_POSITIONAL_PARAMS | MSVCRT_PRINTF_INVOKE_INVALID_PARAM_HANDLER,
+            arg_clbk_valist, NULL, &valist);
+}
+
+/*********************************************************************
+ *		_vcprintf_p (MSVCRT.@)
+ */
+int CDECL _vcprintf_p(const char* format, va_list valist)
+{
+    return _vcprintf_p_l(format, NULL, valist);
+}
+
+/*********************************************************************
+ *		_cprintf_p_l (MSVCRT.@)
+ */
+int WINAPIV _cprintf_p_l(const char* format, _locale_t locale, ...)
+{
+    va_list valist;
+    int res;
+
+    va_start(valist, locale);
+    res = _vcprintf_p_l(format, locale, valist);
+    va_end(valist);
+    return res;
+}
+
+/*********************************************************************
+ *		_cprintf_p (MSVCRT.@)
+ */
