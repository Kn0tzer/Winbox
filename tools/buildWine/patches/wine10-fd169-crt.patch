+
+/***********************************************************************
+ * FD-169 hand implementations: the C11 char16/char32 conversion
+ * functions and __wcsncnt.
+ *
+ * Wine wide characters are UTF-16 code units, so mbrtoc16 is the
+ * locale decode itself (with surrogate splitting for characters the
+ * locale's code page cannot represent, which in practice means
+ * UTF-8 locales), and mbrtoc32 additionally combines a surrogate
+ * pair into a code point. The mbstate_t carries a pending low
+ * surrogate between mbrtoc16/c16rtomb calls; pending values are
+ * stored as the surrogate value itself, which cannot collide with
+ * the byte-sized states Wine's other conversions use.
+ */
+
+static int fd169_pending_surrogate(mbstate_t *state)
+{
+    if (state && *state >= 0xdc00 && *state <= 0xdfff)
+        return *state;
+    return 0;
+}
