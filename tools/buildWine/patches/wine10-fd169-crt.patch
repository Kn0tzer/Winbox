+/*********************************************************************
+ *		_getws_s (MSVCRT.@)
+ */
+wchar_t* CDECL _getws_s(wchar_t *str, size_t size)
+{
+    size_t len;
+
+    if (!MSVCRT_CHECK_PMT(str != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(size != 0)) return NULL;
+
+    if (!fgetws(str, size, stdin))
+        return NULL;
+
+    len = wcslen(str);
+    if (len && str[len - 1] == '\n')
+    {
+        str[--len] = 0;
+        if (len && str[len - 1] == '\r')
+            str[--len] = 0;
+        return str;
+    }
+    if (len == size - 1 && !feof(stdin))
+    {
