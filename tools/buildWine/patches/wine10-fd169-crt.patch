+         * secure CRT does (invalid parameter handler, NULL result) */
+        int ch;
+        while ((ch = fgetwc(stdin)) != WEOF && ch != '\n')
+            ;
+        *str = 0;
+        if (!MSVCRT_CHECK_PMT_ERR(FALSE, ERANGE)) return NULL;
+    }
+    return str;
