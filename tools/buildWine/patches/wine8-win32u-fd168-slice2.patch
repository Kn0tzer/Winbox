@@ -6223,6 +6236,23 @@ done:
 }
 
 
+/**********************************************************************
+ *           NtGdiPolyTextOutW    (win32u.@)
+ *
+ * Draw each POLYTEXTW entry in order, exactly as a sequence of
+ * NtGdiExtTextOutW calls with the entry's position, flags, clip /
+ * opaque rectangle and advances (the gdi32 PolyTextOutW contract,
+ * carried out on this side of the syscall boundary).
+ */
+BOOL WINAPI NtGdiPolyTextOutW( HDC hdc, const POLYTEXTW *pt, INT count )
+{
+    for (; count > 0; count--, pt++)
+        if (!NtGdiExtTextOutW( hdc, pt->x, pt->y, pt->uiFlags, &pt->rcl, pt->lpstr, pt->n, pt->pdx, 0 ))
+            return FALSE;
+    return TRUE;
+}
+
