+/**********************************************************************
+ *           NtUserIsTopLevelWindow (win32u.@)
+ */
+BOOL WINAPI NtUserIsTopLevelWindow( HWND hwnd )
+{
+    if (!hwnd) return FALSE;
+    return NtUserGetAncestor( hwnd, GA_ROOT ) == hwnd;
+}
