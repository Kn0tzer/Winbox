+/**********************************************************************
+ *           NtGdiGetCharSet    (win32u.@)
+ *
+ * The character set of the font selected into the DC: the same
+ * value NtGdiGetTextCharsetInfo returns when no signature buffer
+ * is requested, which is what gdi32's GetTextCharset exposes.
+ */
+UINT WINAPI NtGdiGetCharSet( HDC hdc )
+{
+    return NtGdiGetTextCharsetInfo( hdc, NULL, 0 );
+}
+
