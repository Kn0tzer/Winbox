     return ret;
 }
 
+/**********************************************************************
+ *           NtUserGetQueueStatusReadonly (win32u.@)
+ *
+ * The NtUserGetQueueStatus query without its side effect: the
+ * changed bits are reported but not consumed, so repeated calls
+ * keep returning them until a clearing NtUserGetQueueStatus call
+ * (or the queue being drained) resets them. The server request
+ * already separates the two: clear_bits stays 0 here.
+ */
+DWORD WINAPI NtUserGetQueueStatusReadonly( UINT flags )
+{
+    DWORD ret;
+
+    if (flags & ~(QS_ALLINPUT | QS_ALLPOSTMESSAGE | QS_SMRESULT))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_FLAGS );
+        return 0;
+    }
+
+    check_for_events( flags );
+
+    SERVER_START_REQ( get_queue_status )
+    {
+        req->clear_bits = 0;
+        wine_server_call( req );
+        ret = MAKELONG( reply->changed_bits & flags, reply->wake_bits & flags );
+    }
+    SERVER_END_REQ;
+    return ret;
+}
+
