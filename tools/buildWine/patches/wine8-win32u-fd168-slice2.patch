+/**********************************************************************
+ *           NtGdiCombineTransform   (win32u.@)
+ */
+BOOL WINAPI NtGdiCombineTransform( XFORM *result, const XFORM *xform1, const XFORM *xform2 )
+{
+    if (!result || !xform1 || !xform2) return FALSE;
+    combine_transform( result, xform1, xform2 );
+    return TRUE;
+}
