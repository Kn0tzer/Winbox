* text=auto
* whitespace=trailing-space,space-before-tab,cr-at-eol

# Redistributed packages and binary fixtures must stay byte-exact.
tools/rootfs64/apps/** -text
*.wasm -text
*.spv -text
*.zip -text
*.exe -text
*.dll -text

# Keep imported vendor snapshots unchanged, including their upstream spacing.
tools/dxvk/src/** -whitespace
tools/vkd3d/src/** -whitespace

# Historical compiled runtime pairs are regression fixtures, not editable source.
testdata/wine32-exception-regression/** -text -whitespace
