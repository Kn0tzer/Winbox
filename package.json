{
  "name": "boxedwine64-browser-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "bootstrap": "python3 tools/browser/bootstrap.py && node tools/browser/stage-vendor.mjs",
    "build": "bash tools/bw64-build.sh",
    "build:export": "bash tools/bw64-build.sh --export-only",
    "test:browser": "node web/tests/browser.mjs",
    "typecheck": "tsc --noEmit",
    "test:legacy": "node --test web/tests/*.test.mjs",
    "test:suite": "node web/tests/suite/runner.mjs --unit",
    "test:suite:browser": "node web/tests/suite/runner.mjs --browser"
  },
  "dependencies": {
    "@mercuryworkshop/wisp-js": "0.5.0",
    "@zip.js/zip.js": "2.22.0",
    "naga-wasm": "30.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@webgpu/types": "0.1.69",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  },
  "packageManager": "pnpm@9.15.0"
}
