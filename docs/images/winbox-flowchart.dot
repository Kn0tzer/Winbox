digraph Winbox {
  graph [
    fontname="Arial",
    bgcolor="#f4f7fb",
    pad=0.35,
    nodesep=0.42,
    ranksep=0.48,
    splines=ortho,
    outputorder=edgesfirst,
    newrank=true
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=13,
    fontcolor="#18324b",
    color="#b6c7d9",
    fillcolor="#ffffff",
    penwidth=1.5,
    margin="0.18,0.12"
  ];

  edge [
    color="#536b80",
    penwidth=1.6,
    arrowsize=0.75,
    arrowhead=normal
  ];

  folder [label="Upload a folder", fillcolor="#edf5ff", color="#85add8"];
  demo [label="Choose a demo program", fillcolor="#edf5ff", color="#85add8"];
  exe [label="Windows .exe\nAuto detect architecture", fillcolor="#eff8f3", color="#82b39c"];

  folder -> exe;
  demo -> exe;
  exe -> x86;
  exe -> x64;

  x86 [label="32-bit x86 CPU emulation", fillcolor="#eaf1fc", color="#7096ce"];
  x64 [label="64-bit x86-64 CPU emulation", fillcolor="#eaf1fc", color="#7096ce"];
  wine [label="Wine\nWindows API compatibility", fillcolor="#eff8f3", color="#82b39c"];
  d3d [label="DirectX 9–11", fillcolor="#fff4e5", color="#d9a152"];
  d3d12 [label="DirectX 12", fillcolor="#fff4e5", color="#d9a152"];
  vulkan [label="Vulkan", fillcolor="#fff4e5", color="#d9a152"];
  gl [label="OpenGL", fillcolor="#f2edfa", color="#9a7bc4"];
  dxvk [label="DXVK", fillcolor="#f4effa", color="#9a7bc4"];
  vkd3d [label="vkd3d", fillcolor="#f4effa", color="#9a7bc4"];
  bridge [label="Vulkan bridge", fillcolor="#edf4ff", color="#7096ce"];
  shader [label="SPIR-V → WGSL", fillcolor="#f0f4fb", color="#9aafc8"];
  glbridge [label="GL-on-WebGPU translation", fillcolor="#f4effa", color="#9a7bc4"];
  webgpu [label="WebGPU", fillcolor="#e9f6fb", color="#58a0bd"];
  webgl [label="WebGL2 fallback", fillcolor="#e9f6fb", color="#58a0bd"];
  player [label="Browser canvas\ninput and audio processing", fillcolor="#eaf7f1", color="#62a889", penwidth=2];

  x86 -> wine;
  x64 -> wine;
  wine -> d3d;
  wine -> d3d12;
  wine -> vulkan;
  wine -> gl;
  d3d -> dxvk -> bridge;
  d3d12 -> vkd3d -> bridge;
  vulkan -> bridge;
  bridge -> shader -> webgpu;
  gl -> glbridge -> webgpu;
  glbridge -> webgl [style=dashed, color="#8a68b4", fontcolor="#76579f", xlabel="device unavailable"];
  webgpu -> player;
  webgl -> player;

  { rank=same; folder; demo; }
  { rank=same; x86; x64; }
  { rank=same; d3d; d3d12; vulkan; gl; }
  { rank=same; dxvk; vkd3d; glbridge; }
  { rank=same; bridge; glbridge; }
  { rank=same; shader; }
  { rank=same; webgpu; webgl; }
}
