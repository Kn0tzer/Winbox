===NATIVE===
preadv2 pipe off=-1 flags=0            -> 4 errno=0 (Success)
preadv2 pipe off=-2 flags=0            -> -1 errno=22 (Invalid argument)
preadv2 pipe off=0 flags=0             -> -1 errno=29 (Illegal seek)
preadv2 pipe off=-1 flags=HIPRI        -> 4 errno=0 (Success)
preadv pipe off=-1                     -> -1 errno=22 (Invalid argument)
preadv pipe off=-2                     -> -1 errno=22 (Invalid argument)
preadv pipe cnt=2000 off=0             -> -1 errno=29 (Illegal seek)
preadv pipe cnt=-1 off=0               -> -1 errno=29 (Illegal seek)
preadv pipe iov=NULL off=0             -> -1 errno=29 (Illegal seek)
preadv pipe WRITE end off=0            -> -1 errno=29 (Illegal seek)
preadv2 pipe flags=0x80 off=0          -> -1 errno=29 (Illegal seek)
preadv2 pipe flags=0x80 off=-1         -> -1 errno=95 (Operation not supported)
preadv2 pipe cnt=2000 off=0            -> -1 errno=29 (Illegal seek)
preadv2 pipe iov=NULL off=0            -> -1 errno=29 (Illegal seek)
preadv2 file flags=0x80 off=0          -> 16 errno=0 (Success)
preadv file cnt=2000 off=0             -> -1 errno=22 (Invalid argument)
preadv file off=-1                     -> -1 errno=22 (Invalid argument)
preadv file off=-2                     -> -1 errno=22 (Invalid argument)
