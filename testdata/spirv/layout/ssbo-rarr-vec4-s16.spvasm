OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main"  %outColor
OpExecutionMode %main OriginUpperLeft
OpSource GLSL 450
OpDecorate %Block BufferBlock
OpMemberDecorate %Block 0 Offset 0
OpDecorate %arrT ArrayStride 16
OpDecorate %var DescriptorSet 0
OpDecorate %var Binding 0
OpDecorate %outColor Location 0
%void = OpTypeVoid
%f32 = OpTypeFloat 32
%v2f32 = OpTypeVector %f32 2
%v3f32 = OpTypeVector %f32 3
%v4f32 = OpTypeVector %f32 4
%int = OpTypeInt 32 1
%uint = OpTypeInt 32 0
%arrT = OpTypeRuntimeArray %v4f32
%Block = OpTypeStruct %arrT
%ptrBlock = OpTypePointer StorageBuffer %Block
%var = OpVariable %ptrBlock StorageBuffer
%ptrV = OpTypePointer StorageBuffer %v4f32
%ptrOut = OpTypePointer Output %v4f32
%outColor = OpVariable %ptrOut Output
%fnT = OpTypeFunction %void
%c0 = OpConstant %int 0
%c1 = OpConstant %int 1

%f1 = OpConstant %f32 1.0
%main = OpFunction %void None %fnT
%lbl = OpLabel
%pv = OpAccessChain %ptrV %var %c0 %c1
%v = OpLoad %v4f32 %pv
%x = OpCompositeExtract %f32 %v 0
%out = OpCompositeConstruct %v4f32 %x %x %x %f1
OpStore %outColor %out
OpReturn
OpFunctionEnd
