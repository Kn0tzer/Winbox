OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %var %outColor
OpExecutionMode %main OriginUpperLeft
OpSource GLSL 450
OpDecorate %Block Block
OpMemberDecorate %Block 0 Offset 0
OpMemberDecorate %Block 0 MatrixStride 12
OpMemberDecorate %Block 0 ColMajor
OpDecorate %outColor Location 0
%void = OpTypeVoid
%f32 = OpTypeFloat 32
%v2f32 = OpTypeVector %f32 2
%v3f32 = OpTypeVector %f32 3
%v4f32 = OpTypeVector %f32 4
%int = OpTypeInt 32 1
%uint = OpTypeInt 32 0
%m3 = OpTypeMatrix %v3f32 3
%Block = OpTypeStruct %m3
%ptrBlock = OpTypePointer PushConstant %Block
%var = OpVariable %ptrBlock PushConstant
%ptrCol = OpTypePointer PushConstant %v3f32
%ptrOut = OpTypePointer Output %v4f32
%outColor = OpVariable %ptrOut Output
%fnT = OpTypeFunction %void
%c0 = OpConstant %int 0
%c1 = OpConstant %int 1

%f1 = OpConstant %f32 1.0
%main = OpFunction %void None %fnT
%lbl = OpLabel
%pc = OpAccessChain %ptrCol %var %c0 %c1
%col = OpLoad %v3f32 %pc
%x = OpCompositeExtract %f32 %col 2
%out = OpCompositeConstruct %v4f32 %x %x %x %f1
OpStore %outColor %out
OpReturn
OpFunctionEnd
