OpCapability Shader
OpCapability VariablePointers
OpExtension "SPV_KHR_variable_pointers"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %var %outColor
OpExecutionMode %main OriginUpperLeft
OpSource GLSL 450
OpDecorate %Block Block
OpMemberDecorate %Block 0 Offset 0
OpDecorate %arrT ArrayStride 4
OpDecorate %var DescriptorSet 0
OpDecorate %var Binding 0
OpDecorate %outColor Location 0
%void = OpTypeVoid
%bool = OpTypeBool
%f32 = OpTypeFloat 32
%v2f32 = OpTypeVector %f32 2
%v3f32 = OpTypeVector %f32 3
%v4f32 = OpTypeVector %f32 4
%int = OpTypeInt 32 1
%uint = OpTypeInt 32 0
%c_len = OpConstant %uint 4
%arrT = OpTypeArray %f32 %c_len
%Block = OpTypeStruct %arrT
%ptrBlock = OpTypePointer Uniform %Block
%var = OpVariable %ptrBlock Uniform
%ptrElem = OpTypePointer Uniform %f32
%ptrOut = OpTypePointer Output %v4f32
%outColor = OpVariable %ptrOut Output
%fnT = OpTypeFunction %void
%c0 = OpConstant %int 0
%c1 = OpConstant %int 1
%c2 = OpConstant %int 2
%f0 = OpConstant %f32 0.0
%f1 = OpConstant %f32 1.0
%main = OpFunction %void None %fnT
%entry = OpLabel
%pa = OpAccessChain %ptrElem %var %c0 %c1
%pb = OpAccessChain %ptrElem %var %c0 %c2
%p0 = OpAccessChain %ptrElem %var %c0 %c0
%a0 = OpLoad %f32 %p0
%cond = OpFOrdGreaterThan %bool %a0 %f0
OpSelectionMerge %merge None
OpBranchConditional %cond %then %else
%then = OpLabel
OpBranch %merge
%else = OpLabel
OpBranch %merge
%merge = OpLabel
%sel = OpPhi %ptrElem %pa %then %pb %else
%e = OpLoad %f32 %sel
%out = OpCompositeConstruct %v4f32 %e %e %e %f1
OpStore %outColor %out
OpReturn
OpFunctionEnd
