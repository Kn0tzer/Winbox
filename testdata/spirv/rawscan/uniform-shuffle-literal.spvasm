; rawscan fixture F3 (R13, uniformBlocksToStorage pointer trace):
; the testdata/spirv/r13/ubo-f32-stride4 shape (a struct{float[4]}
; block whose array stride 4 fits storage but not uniform) with the
; block variable at id 7, plus an OpVectorShuffle whose component
; LITERAL 7 selects the second vector's w. The shuffle consumes only
; untraced values; a raw word scan reads the literal as the traced
; block pointer escaping and aborts a valid demotion; the
; operand-aware scan demotes it.
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %40 "main" %50
OpExecutionMode %40 OriginUpperLeft
OpDecorate %5 Block
OpMemberDecorate %5 0 Offset 0
OpDecorate %4 ArrayStride 4
OpDecorate %7 DescriptorSet 0
OpDecorate %7 Binding 0
OpDecorate %50 Location 0
%1 = OpTypeFloat 32
%2 = OpTypeInt 32 0
%14 = OpTypeInt 32 1
%3 = OpConstant %2 4
%4 = OpTypeArray %1 %3
%5 = OpTypeStruct %4
%6 = OpTypePointer Uniform %5
%7 = OpVariable %6 Uniform
%8 = OpTypePointer Uniform %1
%9 = OpTypeVector %1 4
%10 = OpTypePointer Output %9
%50 = OpVariable %10 Output
%11 = OpTypeVoid
%12 = OpTypeFunction %11
%15 = OpConstant %14 0
%16 = OpConstant %14 1
%17 = OpConstant %1 0.5
%40 = OpFunction %11 None %12
%41 = OpLabel
%42 = OpAccessChain %8 %7 %15 %16
%43 = OpLoad %1 %42
%44 = OpCompositeConstruct %9 %43 %43 %43 %17
%45 = OpVectorShuffle %9 %44 %44 7 0 1 2
OpStore %50 %45
OpReturn
OpFunctionEnd
